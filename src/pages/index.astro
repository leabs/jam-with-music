  .filter-creature-portrait path,
  .filter-creature-portrait circle,
  .filter-creature-portrait ellipse {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .filter-creature-response {
    display: block;
    width: 100%;
    height: 6px;
    flex: none;
    overflow: visible;
  }

  .filter-creature-response path {
    fill: none;
    stroke: var(--hardware-muted, #5f6870);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.64;
  }

  .creature-accent {
    color: var(--creature-accent);
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .creature-rabbit-pulse {
    fill: currentColor !important;
    stroke: none !important;
    opacity: 0;
  }

  .creature-chameleon-patch {
    fill: currentColor !important;
    stroke: currentColor !important;
  }

  .custom-patch-grid {
    fill: none;
    stroke: var(--hardware-hairline, #a8adb5);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0.75;
  }

  .custom-patch-signal {
    fill: none !important;
    stroke: var(--signal-selection, #00a6d6) !important;
    stroke-width: 2.8 !important;
    stroke-linecap: square !important;
  }

  .custom-patch-node {
    fill: var(--signal-playback, #f05a28) !important;
    stroke: var(--hardware-surface, #f5f6f7) !important;
    stroke-width: 1.5 !important;
  }

  .creature-dragon .creature-dragon-silhouette {
    fill: var(--hardware-ink, #171a1f);
    stroke: var(--hardware-ink, #171a1f);
    stroke-width: 1.8;
  }

  .creature-dragon .creature-dragon-tail,
  .creature-dragon .creature-dragon-horns {
    fill: none;
    stroke: var(--hardware-ink, #171a1f);
    stroke-width: 3.2;
  }

  .creature-dragon .creature-dragon-cutout {
    fill: var(--hardware-surface, #f5f6f7);
    stroke: var(--hardware-surface, #f5f6f7);
    stroke-width: 2;
  }

  .creature-dragon .creature-dragon-eyes-quiet,
  .creature-dragon .creature-dragon-brows,
  .creature-dragon .creature-dragon-nostril {
    fill: none;
    stroke-width: 1.5;
  }

  .creature-dragon .creature-dragon-brows {
    opacity: 0;
    transform: translateY(1px);
  }

  .creature-dragon-flame .creature-flame-outer {
    fill: var(--signal-playback, #f05a28);
    stroke: var(--signal-playback, #f05a28);
  }

  .creature-dragon-flame .creature-flame-inner {
    fill: var(--hardware-surface, #f5f6f7);
    stroke: var(--signal-playback, #f05a28);
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-accent {
    opacity: 0.9;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-rabbit-pulse {
    opacity: 0.17;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-rabbit-pulse {
    animation: creature-rabbit-pulse 340ms ease-out 1 both;
    transform-origin: 50% 55%;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-bear {
    animation: creature-bear-sway 520ms ease-in-out 1 both;
    transform-origin: 50% 80%;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-bird {
    animation: creature-bird-perk 300ms ease-out 1 both;
    transform-origin: 54% 72%;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-snake-head {
    animation: creature-snake-sweep 480ms ease-in-out 1 both;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-snake-sweep {
    stroke-dasharray: 90;
    stroke-dashoffset: 0;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-dragon-flame {
    animation: creature-dragon-flame 520ms ease-out 1 both;
    transform-origin: 86% 45%;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-dragon-eyes-quiet {
    opacity: 0;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-dragon-brows {
    opacity: 1;
    transform: translateY(-1px);
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-dragon-wing {
    transform: scaleX(1.06) translateY(-1px);
    transform-origin: 50% 58%;
  }

  .filter-preset-pedal[data-filter-active="true"] .creature-chameleon-patch {
    animation: creature-chameleon-color 420ms ease-out 1 both;
  }

  .filter-creature-state {
    min-height: 12px;
    flex: none;
    color: var(--hardware-muted, #5f6870);
    font-size: 0.46rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filter-preset-pedal[data-filter-selected="true"] .filter-creature-state::before {
    content: "Bypassed";
  }

  .filter-preset-pedal[data-filter-active="true"] .filter-creature-state::before {
    content: "On";
    color: var(--signal-effect, #00b578);
  }

  .filter-fx-panel[data-available="false"]
    .filter-preset-pedal[data-filter-selected="true"]
    .filter-creature-state::before {
    content: "Unavailable";
    color: var(--hardware-muted, #5f6870);
  }

  .filter-fx-panel[data-available="false"] .creature-accent {
    opacity: 0;
  }

  .filter-fx-panel[data-available="false"] .creature-dragon-brows {
    opacity: 0;
    transform: none;
  }

  .filter-fx-panel[data-available="false"] .creature-dragon-eyes-quiet {
    opacity: 1;
  }

  .filter-fx-panel[data-available="false"] .creature-dragon-wing {
    transform: none;
  }

  .filter-fx-panel[data-available="false"] .creature-gesture,
  .filter-fx-panel[data-available="false"] .creature-accent {
    animation: none;
    transform: none;
  }

  .filter-preset-values {
    flex: none;
    color: var(--hardware-muted, #5f6870);
    font-size: 0.43rem;
    letter-spacing: -0.01em;
  }

  @keyframes creature-rabbit-pulse {
    0% { opacity: 0; transform: scale(0.65); }
    55% { opacity: 0.2; transform: scale(1.08); }
    100% { transform: scale(1); }
  }

  @keyframes creature-bear-sway {
    0%, 100% { transform: rotate(0); }
    38% { transform: rotate(-2deg); }
    70% { transform: rotate(2deg); }
  }

  @keyframes creature-bird-perk {
    0% { transform: translateY(2px) rotate(-1deg); }
    60% { transform: translateY(-3px) rotate(2deg); }
    100% { transform: translateY(0) rotate(0); }
  }

  @keyframes creature-snake-sweep {
    0% { transform: translate(-8px, 5px); }
    55% { transform: translate(4px, -3px); }
    100% { transform: translate(0); }
  }

  @keyframes creature-snake-trace {
    0% { stroke-dashoffset: 90; opacity: 0; }
    70%, 100% { stroke-dashoffset: 0; opacity: 0.9; }
  }

  @keyframes creature-dragon-wake {
    0% { transform: translateY(2px) scaleY(0.96); }
    60% { transform: translateY(-2px) scaleY(1.03); }
    100% { transform: translateY(0) scaleY(1); }
  }

  @keyframes creature-dragon-flame {
    0%, 15% { opacity: 0; transform: scale(0.1); }
    55% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.72); }
  }

  @keyframes creature-chameleon-color {
    0% { opacity: 0; }
    65%, 100% { opacity: 0.9; }
  }
  .filter-fx-shared-controls {
    margin-top: 14px;
    padding: 12px;
    border: 1px solid rgba(110, 231, 162, 0.28);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(22, 29, 25, 0.96), rgba(9, 14, 11, 0.98));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .filter-fx-shared-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .filter-fx-shared-kicker,
  .filter-fx-selected-preset {
    display: block;
  }

  .filter-fx-shared-kicker {
    color: #a7f3d0;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .filter-fx-selected-preset {
    margin-top: 2px;
    color: #d6e8dc;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .filter-fx-shared-controls .filter-fx-layout {
    position: relative;
    display: grid;
    width: 100%;
    max-width: none;
    aspect-ratio: auto;
    grid-template-columns: minmax(210px, 0.8fr) minmax(0, 2fr) minmax(150px, 0.55fr);
    gap: 12px;
    align-items: stretch;
    padding: 0;
    overflow: visible;
    color: #d8e8de;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .filter-fx-shared-controls .filter-fx-layout::before,
  .filter-fx-shared-controls .filter-fx-layout::after {
    display: none;
  }

  .filter-fx-shared-controls .filter-fx-graphic {
    position: relative;
    display: flex;
    width: 100%;
    height: auto;
    min-height: 136px;
    flex-direction: column;
    justify-content: center;
  }

  .filter-fx-shared-controls .filter-fx-graphic svg {
    width: 100%;
    height: auto;
    min-height: 92px;
  }

  .filter-fx-shared-controls .filter-fx-graphic-state {
    position: static;
    margin: 0;
    padding: 0 12px 10px;
    overflow: visible;
    font-size: 0.65rem;
    line-height: 1.35;
    text-align: left;
    white-space: normal;
  }

  .filter-fx-shared-controls .filter-fx-macros {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: 1fr;
    gap: 8px;
    min-width: 0;
    padding: 0;
    border: 0;
  }

  .filter-fx-shared-controls .filter-fx-macro {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    padding: 10px;
    color: #d8e8de;
    border: 1px solid rgba(110, 231, 162, 0.32);
    border-radius: 8px;
    background: rgba(18, 47, 33, 0.44);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .filter-fx-shared-controls .filter-fx-macro-heading {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    font-family: inherit;
    text-transform: none;
  }

  .filter-fx-shared-controls .filter-fx-macro-heading label,
  .filter-fx-shared-controls .filter-fx-macro-heading output {
    color: inherit;
    font-size: 0.63rem;
    line-height: 1.15;
  }

  .filter-fx-shared-controls .filter-fx-knob {
    width: 48px;
    height: 48px;
    border-color: #090c0a;
  }

  .filter-fx-shared-controls .filter-fx-macro input[type="range"] {
    position: static;
    z-index: auto;
    width: 100%;
    min-width: 44px;
    height: auto;
    min-height: 44px;
    margin: -7px 0;
    opacity: 1;
    accent-color: var(--pedal-led);
    transform: none;
  }

  .filter-fx-shared-controls .filter-fx-macro:has(input[type="range"]:focus-visible) {
    outline: none;
    box-shadow: none;
  }

  .filter-fx-shared-controls .filter-fx-macro input:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 2px;
    box-shadow: 0 0 0 5px #111111;
  }

  .filter-fx-shared-controls .filter-fx-macro-hint {
    position: static;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    color: #b7cbbf;
    font-size: 0.57rem;
    line-height: 1.25;
    text-align: center;
    white-space: normal;
  }

  .filter-fx-shared-controls .filter-fx-footswitch {
    position: relative;
    right: auto;
    bottom: auto;
    left: auto;
    display: flex;
    width: 100%;
    height: auto;
    min-height: 84px;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    padding: 12px;
