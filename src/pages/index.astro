    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff7ed;
  }

  #pitchRollCloseBtn,
  #pitchRollResetBtn {
    border: 1px solid rgba(161, 98, 7, 0.55);
    background: linear-gradient(180deg, rgba(69, 51, 38, 0.95), rgba(40, 30, 23, 0.95));
    color: #fed7aa;
    border-radius: 4px;
    padding: 6px 9px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  #pitchRollCloseBtn:hover,
  #pitchRollCloseBtn:focus-visible,
  #pitchRollResetBtn:hover,
  #pitchRollResetBtn:focus-visible {
    border-color: rgba(251, 146, 60, 0.85);
    color: #fff7ed;
    outline: none;
  }

  .pitch-roll-hint {
    margin: 8px 0 10px;
    color: #d9c3ad;
    font-size: 0.66rem;
  }

  .pitch-roll-grid {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.pitch-roll-row) {
    display: grid;
    grid-template-columns: 30px repeat(16, minmax(0, 1fr));
    gap: 2px;
    align-items: center;
  }

  :global(.pitch-roll-row-label) {
    text-align: center;
    color: #fcd9b2;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  :global(.pitch-roll-cell) {
    border: 1px solid rgba(120, 93, 72, 0.55);
    border-radius: 2px;
    background: linear-gradient(180deg, rgba(58, 45, 35, 0.88), rgba(42, 33, 26, 0.9));
    padding: 0;
    cursor: pointer;
    aspect-ratio: 1 / 1;
    min-height: 14px;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  :global(.pitch-roll-cell.is-quarter) {
    border-left-color: rgba(251, 146, 60, 0.75);
  }

  :global(.pitch-roll-cell.is-muted) {
    opacity: 0.7;
  }

  :global(.pitch-roll-cell.is-active) {
    border-color: rgba(251, 146, 60, 0.95);
    background: linear-gradient(180deg, #fdba74, #f97316);
  }

  :global(.pitch-roll-cell:hover) {
    border-color: rgba(251, 146, 60, 0.9);
  }

  :global(.pitch-roll-cell:focus-visible) {
    border-color: rgba(251, 146, 60, 0.9);
    outline: 2px solid #fff7ed;
    outline-offset: 1px;
  }

  .pitch-roll-actions {
    margin-top: 10px;
    display: flex;
    justify-content: flex-end;
  }

  .all-steps {
    width: 100%;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(16, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
  }

  .step {
    background: linear-gradient(180deg, var(--pad-off-hi), var(--pad-off));
    border: none;
    border-radius: 3px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    aspect-ratio: 1 / 1;
    transition: transform 0.09s ease, filter 0.12s ease, box-shadow 0.12s ease;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -2px 0 rgba(0, 0, 0, 0.5),
      0 4px 10px rgba(0, 0, 0, 0.35);
  }

  .step:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .step:nth-child(4n + 1) {
    background: linear-gradient(180deg, #6a4f3a, #4d3829);
    box-shadow:
      inset 0 2px 0 rgba(251, 146, 60, 0.72),
      inset 0 -2px 0 rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(251, 146, 60, 0.38),
      0 4px 10px rgba(0, 0, 0, 0.35);
  }

  .step.active {
    background: linear-gradient(180deg, var(--pad-active-hi), var(--pad-active));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      inset 0 -2px 0 rgba(194, 65, 12, 0.55),
      0 0 0 1px rgba(251, 146, 60, 0.55),
      0 10px 22px rgba(249, 115, 22, 0.35);
  }

  .step.active:nth-child(4n + 1) {
    background: linear-gradient(180deg, #ffedd5, #fb923c);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -2px 0 rgba(194, 65, 12, 0.55),
      0 0 0 1px rgba(255, 237, 213, 0.98),
      0 12px 24px rgba(249, 115, 22, 0.42);
  }

  .step.playing {
    outline: 2px solid rgba(251, 146, 60, 0.95);
    outline-offset: 0;
    box-shadow:
      0 0 0 4px rgba(251, 146, 60, 0.22),
      0 0 22px rgba(249, 115, 22, 0.55);
  }

  .step:focus-visible,
  .step.playing:focus-visible {
    outline: 2px solid #fff7ed;
    outline-offset: 2px;
  }

  @media (max-width: 899px) {
    .header-grid {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .filter-preset-pedal {
      flex: 0 1 calc(33.333% - 8px);
    }

    .filter-fx-pedalboard {
      max-width: 480px;
      margin-inline: auto;
    }

    .filter-fx-shared-controls .filter-fx-layout {
      width: 100%;
      max-width: none;
      grid-template-columns: minmax(170px, 0.7fr) minmax(0, 1.3fr);
    }

    .filter-fx-shared-controls .filter-fx-macros {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, auto);
    }

    .filter-fx-shared-controls .filter-fx-footswitch {
      grid-column: 1 / -1;
      min-height: 64px;
    }
  }

  @media (max-width: 600px) {
    .header-grid {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
      padding: 2px 0;
    }

    .container {
      padding: 4px 4px 8px;
    }

    .audio-status-row {
      align-items: flex-start;
      margin: 2px 2px 6px;
    }

    .filter-fx-panel {
      margin: 0 0 8px;
      border-radius: 6px;
    }

    .filter-fx-bar {
      gap: 6px;
      padding: 4px 5px 4px 9px;
    }

    .filter-fx-heading,
    .filter-fx-bar-actions {
      gap: 5px;
    }

    .filter-fx-action {
      min-width: 58px;
      padding: 7px 9px;
      font-size: 0.66rem;
    }

    .filter-fx-body {
      padding: 0 7px 8px;
    }

    .filter-fx-pedalboard {
      gap: 8px;
      max-width: 320px;
      padding: 7px;
      border-radius: 6px;
    }

    .filter-preset-pedal {
      flex: 0 1 calc(50% - 4px);
      width: min(42vw, 148px);
      min-width: min(112px, calc(50% - 4px));
      max-width: 148px;
    }

    .filter-fx-preset-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 7px;
    }

    .filter-fx-preset-row select {
      width: 100%;
      min-width: 0;
    }

    .filter-fx-shared-controls {
      padding: 9px;
    }

    .filter-fx-shared-controls .filter-fx-layout {
      display: grid;
      width: 100%;
      max-width: none;
      grid-template-columns: 1fr;
      gap: 9px;
      padding: 0;
    }

    .filter-fx-shared-controls .filter-fx-macros {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7px;
    }

    .filter-fx-shared-controls .filter-fx-macro {
      padding: 8px;
    }

    .filter-fx-pedal-identity {
      padding-inline: 5px;
    }

    .filter-fx-shared-controls .filter-fx-graphic {
      min-height: 104px;
      height: auto;
    }

    .filter-fx-shared-controls .filter-fx-footswitch {
      grid-column: 1;
      width: auto;
      min-height: 64px;
    }

    .filter-fx-macro-heading {
      align-items: baseline;
      flex-direction: row;
      gap: 3px;
    }

    .filter-fx-macro-heading output {
      width: auto;
      text-align: right;
    }

    .op1-drum-machine {
      padding: 6px 4px;
      border-radius: 0;
    }

    .sequencer {
      gap: 4px;
      padding: 2px 0;
      border-radius: 0;
    }

    .steps {
      grid-template-columns: repeat(8, 1fr);
      gap: 2px;
    }

    .sequence-row {
      grid-template-columns: 28px 1fr;
      gap: 4px;
      padding: 3px 0;
      border-radius: 0;
      align-items: stretch;
    }

    .instrument-panel {
      padding: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: visible;
    }

    .instrument-label {
      font-size: 0.54rem;
      letter-spacing: 0.06em;
      line-height: 1;
      writing-mode: vertical-rl;
      text-orientation: mixed;
      transform: rotate(180deg);
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }

    .instrument-header {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 100%;
      transform: none;
      transform-origin: initial;
    }

    .instrument-volume-tooltip-wrap {
      margin-left: 0;
    }

    .instrument-volume-trigger {
      width: 20px;
      height: 20px;
    }

    .instrument-pitch-trigger {
      width: 20px;
      height: 20px;
    }

    .instrument-volume-trigger-icon {
      font-size: 0.58rem;
    }

    .instrument-pitch-trigger-icon {
      font-size: 0.58rem;
    }

    .instrument-volume-tooltip {
      left: calc(100% + 6px);
      right: auto;
      width: 38px;
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
      padding: 6px 5px;
      gap: 5px;
    }

    .instrument-volume-slider {
      width: 12px;
      height: 86px;
    }

    .instrument-volume-value {
      font-size: 0.6rem;
    }

    .pitch-roll-dialog {
      padding: 0;
      align-items: flex-end;
    }

    .pitch-roll-sheet {
      width: 100%;
      max-height: 82vh;
      border-radius: 10px 10px 0 0;
      padding: 10px 8px 12px;
    }

    .pitch-roll-header h2 {
      font-size: 0.78rem;
      letter-spacing: 0.03em;
    }

    #pitchRollCloseBtn,
    #pitchRollResetBtn {
      font-size: 0.64rem;
      padding: 5px 7px;
    }

    .pitch-roll-hint {
      font-size: 0.6rem;
      margin: 6px 0 8px;
    }

    :global(.pitch-roll-row) {
      grid-template-columns: 24px repeat(16, minmax(0, 1fr));
      gap: 1px;
    }

    :global(.pitch-roll-row-label) {
      font-size: 0.56rem;
    }

    :global(.pitch-roll-cell) {
      min-height: 13px;
      border-radius: 1px;
    }

    .app-title {
      flex: 0 0 auto;
      font-size: 1rem;
      letter-spacing: 0.02em;
      line-height: 1;
    }

    .app-title-full {
      display: none;
    }

    .app-title-short {
      display: inline;
    }

    .bpm-control {
      flex: 0 0 auto;
      margin-left: auto;
      justify-content: flex-start;
      flex-wrap: nowrap;
      gap: 4px;
      padding: 6px;
      border-radius: 6px;
    }

    .bpm-control label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    #bpm {
      width: 54px;
      font-size: 0.8rem;
      padding: 5px 2px;
    }

    #playBtn,
    #shareBtn,
    #loopPatternBtn,
    #clearProjectBtn,
    #mobileHelpBtn {
      gap: 0;
      min-width: 32px;
      padding: 7px;
      font-size: 0.8rem;
    }

    .mobile-help-wrap {
      display: inline-flex;
    }

    .mobile-help-tooltip {
      width: 166px;
      font-size: 0.62rem;
      padding: 7px;
      top: calc(100% + 6px);
      bottom: auto;
    }

    .btn-icon {
      font-size: 0.85rem;
    }

    .button-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-fx-curve,
    .filter-fx-action,
    .filter-fx-knob-indicator {
      transition: none;
    }

    .filter-preset-shell,
    .filter-preset-mini-knob::after,
    .filter-preset-footplate {
      transition: none;
    }

    .filter-fx-layout::before,
    .filter-fx-footswitch::before {
      transition: none;
    }
  }

  /* Minimal hardware system: a quiet chassis with color reserved for state. */
  :root {
    color-scheme: light;
    --hardware-canvas: #e3e6eb;
    --hardware-surface: #f5f6f7;
    --hardware-ink: #171a1f;
    --hardware-muted: #515860;
    --hardware-hairline: #a8adb5;
    --signal-playback: #f05a28;
    --signal-selection: #00a6d6;
    --signal-alert: #c83d3d;
    --signal-effect: #00b578;
    --daw-bg: var(--hardware-canvas);
    --daw-panel: var(--hardware-surface);
    --daw-panel-2: #d8dce2;
    --daw-border: var(--hardware-hairline);
    --daw-text: var(--hardware-ink);
    --daw-muted: var(--hardware-muted);
    --daw-accent: var(--signal-playback);
    --daw-accent-2: var(--signal-selection);
    --daw-accent-3: var(--signal-effect);
    --pad-off: #d8dce2;
    --pad-off-hi: #f5f6f7;
    --pad-active: var(--signal-selection);
    --pad-active-hi: #54c6e5;
  }

  body {
    background: var(--hardware-canvas);
    color: var(--hardware-ink);
  }

  .container {
    max-width: 1440px;
    padding: 6px 10px 16px;
  }

  .op1-drum-machine {
    padding: 8px 20px 20px;
    border: 1px solid var(--hardware-hairline);
    border-radius: 14px;
    background: var(--hardware-surface);
    box-shadow:
      0 12px 32px rgba(23, 26, 31, 0.1),
      inset 0 1px 0 #ffffff;
  }

  p,
  a,
  label,
  .instrument-label {
    color: var(--hardware-muted);
  }

  .header-grid {
    grid-template-columns: minmax(132px, 0.45fr) minmax(220px, 0.8fr) auto;
    gap: 8px;
    padding: 0;
    margin-bottom: 4px;
  }

  .app-title {
    color: var(--hardware-ink);
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 760;
    letter-spacing: -0.035em;
    text-transform: none;
  }

  .app-title::after {
    content: "step sequencer";
    display: block;
    margin-top: 3px;
    color: var(--hardware-muted);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .instrument-screen {
    --screen-position: 0%;
    position: relative;
    display: grid;
    min-width: 0;
    height: 82px;
    grid-template-rows: auto 1fr auto;
    gap: 5px;
    padding: 8px 10px;
    overflow: hidden;
    color: #f5f6f7;
    border: 2px solid var(--hardware-ink);
    border-radius: 10px;
    background: #171a1f;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  .instrument-screen-head,
  .instrument-screen-readout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.54rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .instrument-screen-head {
    color: var(--hardware-hairline);
  }

  .instrument-screen-readout span:first-child {
    color: var(--signal-playback);
  }

  .instrument-screen-readout span:last-child {
    overflow: hidden;
    color: var(--signal-effect);
    text-overflow: ellipsis;
  }

  .instrument-screen-scope {
    position: relative;
    min-height: 30px;
    overflow: hidden;
    border-block: 1px solid rgba(255, 255, 255, 0.1);
  }

  .instrument-screen-baseline,
  .instrument-screen-trace,
  .instrument-screen-edit-context,
  .instrument-screen-playhead,
  .instrument-screen-pulse {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  .instrument-screen-baseline {
    right: 0;
    bottom: 8px;
    left: 0;
    height: 1px;
    background: var(--hardware-hairline);
  }

  .instrument-screen-trace {
    inset: 3px 2px 6px;
    background: var(--hardware-hairline);
    clip-path: polygon(0 66%, 8% 66%, 12% 48%, 16% 66%, 27% 66%, 31% 34%, 35% 66%, 47% 66%, 51% 54%, 55% 66%, 68% 66%, 73% 24%, 78% 66%, 91% 66%, 95% 44%, 100% 66%, 100% 72%, 94% 54%, 90% 72%, 76% 72%, 73% 35%, 69% 72%, 54% 72%, 51% 61%, 47% 72%, 34% 72%, 31% 42%, 27% 72%, 15% 72%, 12% 56%, 8% 72%, 0 72%);
    opacity: 0.9;
  }

  .instrument-screen[data-filter-active="true"] .instrument-screen-trace {
    background: var(--signal-effect);
  }

  .instrument-screen-edit-context {
    right: 18%;
    bottom: 3px;
    left: 18%;
    height: 2px;
    border-radius: 999px;
    background: var(--signal-selection);
    opacity: 0.9;
  }

  .instrument-screen-playhead {
    top: 2px;
    bottom: 2px;
    left: var(--screen-position);
    width: 2px;
    border-radius: 999px;
    background: var(--signal-playback);
    box-shadow: 0 0 0 2px rgba(240, 90, 40, 0.15);
    transform: translateX(-1px);
    transition: left 70ms linear;
  }

  .instrument-screen-pulse {
    top: 50%;
    left: var(--screen-position);
    width: 18px;
    height: 3px;
    border-radius: 999px;
    background: var(--signal-playback);
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0.3);
  }

  .instrument-screen[data-playing="true"][data-tick="even"] .instrument-screen-pulse {
    animation: groove-pulse-even 210ms ease-out;
  }

  .instrument-screen[data-playing="true"][data-tick="odd"] .instrument-screen-pulse {
    animation: groove-pulse-odd 210ms ease-out;
  }

  @keyframes groove-pulse-even {
    0% { opacity: 0.9; transform: translate(-50%, -50%) scaleX(0.35); }
    100% { opacity: 0; transform: translate(-50%, -50%) scaleX(1); }
  }

  @keyframes groove-pulse-odd {
    0% { opacity: 0.9; transform: translate(-50%, -50%) scaleX(0.35); }
    100% { opacity: 0; transform: translate(-50%, -50%) scaleX(1); }
  }

  .bpm-control {
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--hardware-hairline);
    border-radius: 10px;
    background: var(--hardware-canvas);
    box-shadow: none;
  }

  .bpm-control label {
    color: var(--hardware-muted);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.65rem;
  }

  #bpm {
    width: 60px;
    min-height: 44px;
    padding: 7px 4px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    border-radius: 6px;
    background: var(--hardware-surface);
    box-shadow: inset 0 -1px 0 rgba(23, 26, 31, 0.08);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-weight: 760;
  }

  #bpm:focus,
  #playBtn:focus-visible,
  #shareBtn:focus-visible,
  #loopPatternBtn:focus-visible,
  #clearProjectBtn:focus-visible,
  #mobileHelpBtn:focus-visible,
  .retry-samples-btn:focus-visible,
  .instrument-volume-trigger:focus-visible,
  .instrument-pitch-trigger:focus-visible,
  #pitchRollCloseBtn:focus-visible,
  #pitchRollResetBtn:focus-visible,
  .step:focus-visible,
  .step.playing:focus-visible {
    outline: 3px solid var(--hardware-ink, #171a1f);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--signal-effect, #00b578);
  }

  #playBtn,
  #shareBtn,
  #loopPatternBtn,
  #clearProjectBtn,
  #mobileHelpBtn {
    min-width: 44px;
    min-height: 44px;
    padding: 8px 11px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    border-radius: 6px;
    background: var(--hardware-surface);
    box-shadow: 0 1px 0 rgba(23, 26, 31, 0.08);
    transition: transform 100ms ease, border-color 120ms ease, background 120ms ease;
  }

  #playBtn[data-mode="play"] {
    color: var(--hardware-ink);
    border-color: var(--signal-playback);
    background: var(--signal-playback);
  }

  #playBtn[data-mode="stop"] {
    color: var(--hardware-ink);
    border-color: var(--hardware-hairline);
    background: var(--hardware-hairline);
  }

  #playBtn:hover,
  #shareBtn:hover,
  #loopPatternBtn:hover,
  #mobileHelpBtn:hover {
    color: var(--hardware-ink);
    border-color: var(--hardware-muted);
    background: var(--hardware-canvas);
    box-shadow: 0 1px 0 rgba(23, 26, 31, 0.08);
    filter: none;
    transform: translateY(-1px);
  }

  #playBtn[data-mode="play"]:hover {
    border-color: var(--hardware-ink);
    background: var(--signal-playback);
  }

  #loopPatternBtn {
    margin-left: 4px;
    border-left-width: 3px;
  }

  #loopPatternBtn.is-active,
  #loopPatternBtn.is-active:hover {
    color: var(--hardware-ink);
    border-color: var(--signal-selection);
    background: var(--signal-selection);
  }

  #shareBtn {
    margin-left: 4px;
  }

  #clearProjectBtn,
  #clearProjectBtn:hover {
    color: #8a3432;
    border-color: #ddb1ae;
    background: #fff5f3;
  }

  .mobile-help-tooltip,
  .instrument-volume-tooltip {
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    background: var(--hardware-surface);
    box-shadow: 0 12px 28px rgba(23, 26, 31, 0.16);
  }

  .audio-status-row {
    min-height: 34px;
    margin: 0 0 4px;
    padding: 5px 8px;
    border-left: 3px solid var(--hardware-hairline);
  }

  :global(.pattern-manager) {
    margin: 0 0 4px;
  }

  .audio-status {
    color: var(--hardware-muted);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  .audio-status[data-state="error"] { color: #9c3d39; }
  .audio-status[data-state="warning"] { color: var(--hardware-muted); }

  .retry-samples-btn {
    min-height: 44px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    background: var(--hardware-surface);
  }

  .filter-fx-panel {
    --filter-green: var(--signal-effect);
    --filter-green-bright: #367d58;
    margin-bottom: 10px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    border-radius: 10px;
    background: var(--hardware-surface);
    box-shadow: none;
  }

  .filter-fx-bar {
    min-height: 48px;
    padding: 2px 5px 2px 12px;
  }

  .filter-fx-heading,
  .filter-fx-bar-actions {
    min-width: 0;
  }

  .filter-fx-heading {
    flex: 1 1 auto;
    overflow: hidden;
    gap: 6px;
  }

  .filter-fx-effect-names {
    display: inline-flex;
    flex: 0 1 auto;
    min-width: 0;
    gap: 5px;
    color: var(--hardware-muted);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .filter-fx-effect-names span + span::before {
    margin-right: 5px;
    color: var(--signal-selection);
    content: "/";
  }

  .filter-fx-title,
  .filter-fx-status,
  .filter-fx-help,
  .filter-fx-shared-kicker,
  .filter-fx-selected-preset {
    color: var(--hardware-ink);
  }

  .filter-fx-title,
  .filter-fx-shared-kicker {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    letter-spacing: 0.1em;
  }

  .filter-fx-status {
    color: var(--hardware-muted);
  }

  .filter-fx-status-dot {
    background: #a7aca7;
    box-shadow: none;
  }

  .filter-fx-panel[data-enabled="true"] .filter-fx-status-dot {
    background: var(--signal-effect);
    box-shadow: 0 0 0 3px rgba(0, 181, 120, 0.14);
  }

  .filter-fx-action {
    min-width: 44px;
    min-height: 44px;
    max-width: 100%;
    padding-inline: 8px;
    color: var(--hardware-ink);
    border: 1px solid var(--signal-effect);
    border-radius: 6px;
    background: var(--hardware-surface);
  }

  .filter-fx-action:hover:not(:disabled) {
    border-color: var(--signal-effect);
    background: var(--signal-effect);
    filter: none;
  }

  .filter-fx-action:focus-visible,
  .filter-fx-macro input:focus-visible,
  .filter-preset-pedal:focus-visible,
  .filter-fx-shared-controls .filter-fx-macro input:focus-visible {
    outline: 3px solid var(--hardware-ink, #171a1f);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--signal-effect, #00b578);
  }

  .filter-fx-body {
    display: grid;
    grid-template-rows: 1fr;
    padding: 0;
    overflow: hidden;
    opacity: 1;
    transform: translateY(0);
    transition:
      grid-template-rows 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .filter-fx-body[data-expanded="false"] {
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-6px);
  }

  .filter-fx-body-inner {
    min-height: 0;
    padding: 0 12px 12px;
    overflow: hidden;
  }

  .filter-fx-body[hidden] {
    display: none;
  }

  .filter-fx-help {
    margin: 8px 0 10px;
    color: var(--hardware-muted);
    line-height: 1.45;
  }

  .filter-fx-pedalboard {
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--hardware-hairline);
    border-radius: 8px;
    background: var(--hardware-canvas);
  }

  .filter-fx-shared-controls {
    margin-top: 10px;
    padding: 10px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    border-radius: 8px;
    background: var(--hardware-surface);
    box-shadow: none;
  }

  .filter-fx-shared-controls .filter-fx-layout {
    position: static;
    display: grid;
    width: auto;
    max-width: none;
    aspect-ratio: auto;
    isolation: auto;
    grid-template-columns: minmax(170px, 0.7fr) minmax(0, 2fr) minmax(120px, 0.5fr);
    gap: 10px;
    padding: 0;
    overflow: visible;
    color: var(--hardware-ink);
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  .filter-fx-shared-controls .filter-fx-layout::before,
  .filter-fx-shared-controls .filter-fx-layout::after {
    display: none;
  }

  .filter-fx-shared-controls .filter-fx-graphic {
    min-height: 110px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    border-radius: 7px;
    background: var(--hardware-surface);
  }

  .filter-fx-shared-controls .filter-fx-graphic svg {
    min-height: 72px;
  }

  .filter-fx-grid-line { stroke: var(--hardware-hairline); }
  .filter-fx-curve { stroke: var(--signal-effect); }
  .filter-fx-curve-halo { stroke: rgba(0, 181, 120, 0.18); }

  .filter-fx-shared-controls .filter-fx-macro {
    gap: 4px;
    padding: 8px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    border-radius: 7px;
    background: var(--hardware-surface);
    box-shadow: none;
  }

  .filter-fx-shared-controls .filter-fx-knob {
    width: 40px;
    height: 40px;
  }

  .filter-fx-shared-controls .filter-fx-macro input[type="range"] {
    min-height: 44px;
    accent-color: var(--signal-effect);
  }

  .filter-fx-shared-controls .filter-fx-macro-hint,
  .filter-fx-shared-controls .filter-fx-graphic-state {
    color: var(--hardware-muted);
  }

  .filter-fx-shared-controls .filter-fx-footswitch {
    position: static;
    width: 100%;
    height: auto;
    min-height: 56px;
    padding: 8px 12px;
    overflow: visible;
    color: var(--hardware-ink);
    border: 1px solid var(--signal-effect);
    border-radius: 7px;
    background: var(--hardware-surface);
    box-shadow: none;
    transform: none;
  }

  .filter-fx-shared-controls .filter-fx-footswitch::before {
    display: none;
  }

  .filter-fx-shared-controls .filter-fx-footswitch[aria-pressed="true"] {
    color: var(--hardware-ink);
    border-color: var(--signal-effect);
    background: var(--signal-effect);
    box-shadow: none;
    transform: none;
  }

  .sequencer {
    gap: 6px;
    padding: 9px;
    border: 1px solid var(--hardware-hairline);
    border-radius: 10px;
    background: var(--hardware-canvas);
    box-shadow: none;
  }

  .sequence-row {
    grid-template-columns: minmax(184px, 204px) minmax(0, 1fr);
    gap: 8px;
    padding: 6px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: var(--hardware-surface);
  }

  .sequence-row:nth-child(2n) {
    background: #eef0f3;
  }

  .sequence-row[data-sample-state="failed"] .instrument-panel {
    outline-color: var(--signal-alert);
  }

  .instrument-panel {
    padding: 5px 7px;
    border: 1px solid var(--hardware-hairline);
    border-radius: 6px;
    background: var(--hardware-canvas);
    box-shadow: none;
  }

  .instrument-header {
    grid-template-columns: minmax(0, 1fr) 44px 44px;
    gap: 5px;
  }

  .instrument-label {
    color: var(--hardware-ink);
    font-size: 0.67rem;
    font-weight: 760;
    letter-spacing: 0.025em;
    text-transform: none;
  }

  .instrument-volume-trigger,
  .instrument-pitch-trigger {
    width: 44px;
    height: 44px;
    color: var(--hardware-muted);
    border: 1px solid var(--hardware-hairline);
    border-radius: 6px;
    background: var(--hardware-surface);
    transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
  }

  .instrument-volume-trigger:hover,
  .instrument-volume-trigger[aria-expanded="true"],
  .instrument-pitch-trigger:hover {
    color: var(--signal-selection);
    border-color: var(--signal-selection);
    background: var(--signal-selection);
  }

  .instrument-volume-slider {
    accent-color: var(--signal-selection);
  }

  .instrument-volume-value {
    color: var(--hardware-ink);
  }

  .steps {
    gap: 5px;
  }

  .step,
  .step:nth-child(4n + 1) {
    border: 1px solid var(--hardware-hairline);
    border-radius: 4px;
    background: var(--pad-off-hi);
    box-shadow: inset 0 -2px 0 rgba(23, 26, 31, 0.1);
    transition: transform 90ms ease, border-color 100ms ease, background 100ms ease;
  }

  .step:nth-child(4n + 1) {
    border-left: 3px solid var(--hardware-muted);
    background: var(--hardware-canvas);
  }

  .step:hover {
    border-color: var(--signal-selection);
    background: var(--hardware-surface);
    filter: none;
  }

  .step.active,
  .step.active:nth-child(4n + 1) {
    border-color: var(--signal-selection);
    background: var(--signal-selection);
    box-shadow: inset 0 -2px 0 rgba(23, 26, 31, 0.24);
  }

  .step.playing,
  .step.active.playing {
    outline: 3px solid var(--signal-playback);
    outline-offset: 1px;
    box-shadow: 0 0 0 2px rgba(240, 90, 40, 0.2);
  }

  .pitch-roll-dialog {
    background: rgba(23, 26, 31, 0.48);
  }

  .pitch-roll-sheet {
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    background: var(--hardware-surface);
    box-shadow: 0 22px 55px rgba(23, 26, 31, 0.2);
  }

  .pitch-roll-header h2,
  .pitch-roll-hint,
  :global(.pitch-roll-row-label) {
    color: var(--hardware-ink);
  }

  #pitchRollCloseBtn,
  #pitchRollResetBtn {
    min-height: 44px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    background: var(--hardware-canvas);
  }

  :global(.pitch-roll-cell) {
    border-color: var(--hardware-hairline);
    background: var(--hardware-canvas);
  }

  :global(.pitch-roll-cell.is-quarter) {
    border-left-color: var(--hardware-muted);
  }

  :global(.pitch-roll-cell.is-active) {
    border-color: var(--signal-selection);
    background: var(--signal-selection);
  }

  :global(.pitch-roll-cell:focus-visible) {
    border-color: var(--signal-effect);
    outline: 3px solid var(--hardware-ink, #171a1f);
    outline-offset: 1px;
    box-shadow: 0 0 0 6px var(--signal-effect, #00b578);
  }

  :global(.arrange-row) {
    color: var(--hardware-ink);
  }

  :global(.arrange-drag-handle),
  :global(.arrange-times-label) {
    color: var(--hardware-muted);
  }

  :global(.arrange-pattern-card) {
    min-height: 44px;
    color: var(--hardware-ink);
    border-color: var(--hardware-hairline);
    background: var(--hardware-surface);
  }

  :global(.arrange-pattern-card.is-selected) {
    color: var(--hardware-ink);
    border-color: var(--signal-selection);
    background: var(--signal-selection);
    box-shadow: inset 3px 0 0 var(--signal-selection);
  }

  :global(.arrange-pattern-button) {
    min-height: 44px;
  }

  :global(.arrange-row-action) {
    width: 44px;
    height: 44px;
    color: var(--hardware-muted);
  }

  :global(.arrange-row-action:hover) {
    color: var(--hardware-ink);
    background: var(--hardware-canvas);
  }

  :global(.arrange-row-action.is-delete) {
    color: #9c3d39;
  }

  :global(.arrange-pattern-button:focus-visible),
  :global(.arrange-row-action:focus-visible),
  :global(.arrange-repeat-input:focus-visible) {
    outline: 3px solid var(--pattern-ink, #171a1f);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--pattern-green, #00b578);
  }

  :global(.arrange-repeat-input) {
    min-height: 44px;
    color: var(--hardware-ink);
    border-color: var(--hardware-hairline);
    background: var(--hardware-surface);
  }

  /* Slice 4 Space bay: additive hardware layer only. */
  .tone-fx-panel,
  .space-fx-panel {
    margin-top: 10px;
    padding: 10px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    border-radius: 8px;
    background: var(--hardware-canvas);
  }

  .tone-fx-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  .tone-fx-header h2 {
    margin: 2px 0 0;
    font-size: 1rem;
  }

  .tone-fx-kicker,
  #toneFxStatus {
    color: var(--hardware-muted);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  .space-fx-header,
  .space-fx-macro label,
  .space-fx-macro output {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .space-fx-header h2 {
    margin: 2px 0 0;
    font-size: 1rem;
  }

  .space-fx-kicker,
  .space-fx-status,
  .space-fx-summary,
  .space-fx-macro span {
    color: var(--hardware-muted);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  .space-fx-help,
  .space-fx-summary {
    margin: 7px 0;
  }

  .space-fx-presets {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .space-fx-presets button,
  .space-fx-bypass {
    min-height: 44px;
    color: var(--hardware-ink);
    border: 1px solid var(--hardware-hairline);
    border-radius: 6px;
    background: var(--hardware-surface);
  }

  .space-fx-presets button {
    display: grid;
    place-items: center;
    gap: 2px;
    padding: 7px;
  }

  .space-fx-presets svg {
    width: 72px;
    max-width: 100%;
    height: 46px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .space-creature-gesture {
    visibility: hidden;
    transform-box: fill-box;
    transform-origin: center;
  }

  .space-mole-dust { stroke: #f05a28; }
  .space-whale-sonar { stroke: #00b578; }
  .space-jellyfish-ripple { fill: #f05a28; stroke: #00a6d6; }
  .space-snail-crescent { fill: none; stroke: #00b578; }

  .space-fx-panel[data-enabled="true"][data-available="true"]
    .space-fx-presets button:is([data-space-selected="true"]) .space-mole-dust {
    animation: space-mole-dust 620ms ease-out 1 both;
  }

  .space-fx-panel[data-enabled="true"][data-available="true"]
    .space-fx-presets button:is([data-space-selected="true"]) .space-whale-sonar {
    animation: space-whale-sonar 760ms ease-out 1 both;
  }

  .space-fx-panel[data-enabled="true"][data-available="true"]
    .space-fx-presets button:is([data-space-selected="true"]) .space-jellyfish-ripple {
    animation: space-jellyfish-ripple 700ms ease-out 1 both;
  }

  .space-fx-panel[data-enabled="true"][data-available="true"]
    .space-fx-presets button:is([data-space-selected="true"]) .space-snail-crescent {
    animation: space-snail-crescent 680ms ease-out 1 both;
  }

  .space-fx-panel[data-enabled="false"] .space-creature-gesture,
  .space-fx-panel[data-available="false"] .space-creature-gesture {
    animation: none;
    visibility: hidden;
  }

  @keyframes space-mole-dust {
    0% { visibility: visible; opacity: 0; transform: translateY(4px) scale(0.7); }
    45% { opacity: 1; }
    100% { visibility: hidden; opacity: 0; transform: translateY(-3px) scale(1.08); }
  }

  @keyframes space-whale-sonar {
    0% { visibility: visible; opacity: 0; transform: scale(0.55); }
    45% { opacity: 1; }
    100% { visibility: hidden; opacity: 0; transform: scale(1.18); }
  }

  @keyframes space-jellyfish-ripple {
    0% { visibility: visible; opacity: 0; transform: scale(0.7); }
    50% { opacity: 0.9; }
    100% { visibility: hidden; opacity: 0; transform: scale(1.15); }
  }

  @keyframes space-snail-crescent {
    0% { visibility: visible; opacity: 0; transform: rotate(-18deg) scale(0.72); }
    55% { opacity: 1; }
    100% { visibility: visible; opacity: 1; transform: rotate(12deg) scale(1.05); }
  }

  .space-fx-presets button[data-space-selected="true"] {
    border-color: var(--hardware-ink);
    box-shadow:
      inset 0 -4px 0 var(--hardware-ink),
      inset 0 -7px 0 var(--signal-effect);
  }

  .space-fx-custom-preset {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  .space-fx-macros {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 10px 0;
    padding: 0;
    border: 0;
  }

  .space-fx-macro {
    display: grid;
    gap: 5px;
  }

  .space-fx-macro input {
    width: 100%;
    min-height: 44px;
  }

  .space-fx-bypass {
    width: 100%;
    border-color: var(--signal-effect);
  }

  .space-fx-presets button:focus-visible,
  .space-fx-macro input:focus-visible,
  .space-fx-bypass:focus-visible {
    outline: 3px solid var(--hardware-ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--signal-effect);
  }

  .space-fx-panel[data-available="false"] .space-fx-presets button,
  .space-fx-panel[data-available="false"] .space-fx-macro input,
  .space-fx-panel[data-available="false"] .space-fx-bypass,
  .space-fx-panel[data-available="false"] .space-fx-presets svg {
    opacity: 0.72;
  }

  @media (min-width: 900px) {
    .op1-drum-machine {
      --desktop-lane-row: 44px;
    }

    .header-grid {
      height: 56px;
      grid-template-columns: minmax(118px, 0.36fr) minmax(260px, 0.84fr) auto;
      gap: 8px;
      margin-bottom: 4px;
    }

    .app-title {
      max-height: 48px;
      font-size: clamp(1.2rem, 1.8vw, 1.65rem);
    }

    .instrument-screen {
      height: 56px;
      gap: 2px;
      padding: 4px 8px;
    }

    .instrument-screen-scope {
      min-height: 20px;
    }

    .bpm-control {
      height: 56px;
      flex-wrap: nowrap;
      gap: 4px;
      padding: 4px;
    }

    .audio-status-row {
      min-height: 24px;
      margin: 0 0 4px;
      padding: 2px 6px;
    }

    .filter-fx-panel {
      margin: 0 0 10px;
      overflow: visible;
    }

    .filter-fx-body-inner {
      display: block;
    }

    .filter-fx-help,
    .filter-fx-pedalboard {
      grid-column: 1 / -1;
    }

    .tone-fx-panel,
    .space-fx-panel {
      margin-top: 0;
    }

    .filter-fx-bar {
      height: 48px;
      min-height: 48px;
      padding: 0 4px 0 10px;
    }

    .sequencer {
      gap: 0;
      padding: 4px;
    }

    .sequence-row {
      position: relative;
      height: var(--desktop-lane-row);
      min-height: var(--desktop-lane-row);
      grid-template-columns: minmax(140px, 176px) minmax(0, 1fr);
      gap: 4px;
      padding: 0;
      border: 0;
    }

    .sequence-row:not(:last-child)::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 1px;
      background: var(--hardware-hairline);
      content: "";
      pointer-events: none;
    }

    .instrument-panel {
      height: 44px;
      padding: 0 6px;
      border: 0;
      box-shadow: inset 0 0 0 1px var(--hardware-hairline);
    }

    .instrument-header {
      height: 44px;
      gap: 2px;
    }

    .all-steps {
      overflow-x: auto;
    }

    .steps {
      height: 44px;
      grid-template-columns: repeat(16, minmax(44px, 56px));
      justify-content: space-between;
      gap: 4px;
    }

    .step,
    .step:nth-child(4n + 1) {
      height: 44px;
      min-height: 44px;
      aspect-ratio: auto;
    }
  }

  @media (min-width: 1400px) {
    .filter-fx-body-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
      gap: 10px;
      align-items: start;
    }

    .filter-fx-help,
    .filter-fx-pedalboard {
      grid-column: 1 / -1;
    }

    .filter-fx-shared-controls .filter-fx-macros {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, 1fr);
    }
  }

  @media (max-width: 899px) {
    .header-grid {
      grid-template-columns: minmax(110px, 0.35fr) minmax(210px, 0.65fr);
    }

    .bpm-control {
      grid-column: 1 / -1;
      justify-content: center;
    }

    .filter-fx-pedalboard {
      flex-wrap: wrap;
      max-width: 390px;
    }

    .filter-preset-pedal {
      flex: 0 0 clamp(88px, 14vw, 116px);
      width: clamp(88px, 14vw, 116px);
