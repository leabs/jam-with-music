---
import Layout from "../layouts/Layout.astro";
import ArrangeDialog from "../components/ArrangeDialog.jsx";
import ClearProjectDialog from "../components/ClearProjectDialog.jsx";
import {
  FiHelpCircle,
  FiMusic,
  FiPlay,
  FiRepeat,
  FiShare2,
  FiSquare,
  FiTrash2,
  FiVolume2,
} from "react-icons/fi";
// Supports weights 300-800
import "@fontsource-variable/open-sans";
---

<Layout>
  <div class="op1-drum-machine container">
    <div class="header-grid">
      <h1 class="app-title" aria-label="Open Beats">
        <span class="app-title-full">Open Beats</span>
        <span class="app-title-short" aria-hidden="true">OB</span>
      </h1>

      <div
        class="instrument-screen"
        id="instrumentScreen"
        role="img"
        aria-label="Stopped, 120 BPM, Filter bypassed."
        data-playing="false"
      >
        <div class="instrument-screen-head" aria-hidden="true">
          <span>STEP SCOPE</span>
          <span><span data-screen-bpm>120</span> BPM</span>
        </div>
        <div class="instrument-screen-scope" aria-hidden="true">
          <span class="instrument-screen-baseline"></span>
          <span class="instrument-screen-trace"></span>
          <span class="instrument-screen-edit-context"></span>
          <span class="instrument-screen-playhead"></span>
          <span class="instrument-screen-pulse"></span>
        </div>
        <div class="instrument-screen-readout" aria-hidden="true">
          <span data-screen-mode>STOPPED</span>
          <span data-screen-filter>FILTER BYPASSED</span>
        </div>
      </div>

      <!-- BPM Control -->
      <div class="bpm-control">
        <label for="bpm">BPM:</label>
        <input type="number" id="bpm" value="120" min="40" max="300" />
        <button id="playBtn" type="button" data-mode="play" aria-describedby="audioStatus" disabled>
          <span class="btn-icon" id="playBtnIconPlay"><FiPlay /></span>
          <span class="btn-icon btn-icon-hidden" id="playBtnIconStop">
            <FiSquare />
          </span>
          <span class="button-label" id="playBtnLabel">Play</span>
        </button>
        <button id="loopPatternBtn" type="button" aria-pressed="false" disabled>
          <span class="btn-icon"><FiRepeat /></span>
          <span class="button-label" data-loop-label>Loop Pattern</span>
        </button>
        <button id="shareBtn" type="button" disabled>
          <span class="btn-icon"><FiShare2 /></span>
          <span class="button-label">Share</span>
        </button>
        <button id="clearProjectBtn" type="button" disabled>
          <span class="btn-icon"><FiTrash2 /></span>
          <span class="button-label">Clear Project</span>
        </button>
        <div class="mobile-help-wrap">
          <button
            id="mobileHelpBtn"
            type="button"
            aria-label="Playback help"
            aria-expanded="false"
            aria-controls="mobileHelpTooltip"
          >
            <span class="btn-icon"><FiHelpCircle /></span>
          </button>
          <div id="mobileHelpTooltip" class="mobile-help-tooltip" role="tooltip">
            Make sure your phone is unmuted to hear the playback.
          </div>
        </div>
      </div>
    </div>

    <div class="audio-status-row">
      <p
        id="audioStatus"
        class="audio-status"
        role="status"
        aria-live="polite"
        tabindex="-1"
      >
        Preparing sounds…
      </p>
      <button id="retrySamplesBtn" class="retry-samples-btn" type="button" hidden>
        Retry failed sounds
      </button>
    </div>

    <ArrangeDialog client:load />

    <section
      id="filterFxPanel"
      class="filter-fx-panel"
      aria-labelledby="filterFxTitle"
      data-enabled="false"
      data-available="true"
      data-preset="clean"
    >
      <div class="filter-fx-bar">
        <div class="filter-fx-heading">
          <span class="filter-fx-title" id="filterFxTitle">EFFECTS</span>
          <span class="filter-fx-status-dot" aria-hidden="true"></span>
          <span class="filter-fx-effect-names" aria-label="Tone and Reverb">
            <span>TONE</span><span>REVERB</span>
          </span>
          <span
            class="filter-fx-status"
            id="filterFxStatus"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >Tone: Bypassed · Space: Bypassed</span>
          <span
            class="sr-only"
            id="filterFxActionStatus"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          ></span>
        </div>
        <div class="filter-fx-bar-actions">
          <button
            id="filterFxToggle"
            class="filter-fx-action"
            type="button"
            aria-label="Show effects"
            aria-expanded="false"
            aria-controls="filterFxBody"
          >
            <span data-filter-toggle-label>Show effects</span>
          </button>
        </div>
      </div>

      <div
        class="filter-fx-body filter-fx-pedalboard-shelf"
        id="filterFxBody"
        data-expanded="false"
        aria-hidden="true"
        inert
        hidden
      >
        <div class="filter-fx-body-inner">
        <section class="tone-fx-panel" aria-labelledby="toneFxTitle" aria-describedby="filterFxHelp">
        <div class="tone-fx-header">
          <div><span class="tone-fx-kicker">TONE FILTER</span><h2 id="toneFxTitle">Tone</h2></div>
          <span id="toneFxStatus" role="status" aria-live="polite">Bypassed</span>
        </div>
        <p class="filter-fx-help" id="filterFxHelp">
          Filter reshapes the whole groove. Cutoff moves from dark to bright. Resonance
          adds a peak. Drive adds grit. Mix blends the filtered sound with the clean
          signal.
        </p>

        <div class="sr-only" aria-hidden="true">
          <label for="filterFxPreset">Preset state mirror</label>
          <select id="filterFxPreset" tabindex="-1" disabled>
            <option value="clean">Clean</option>
            <option value="warm">Warm</option>
            <option value="bright">Bright</option>
            <option value="resonant-sweep">Resonant Sweep</option>
            <option value="grit">Grit</option>
            <option value="custom" disabled>Custom</option>
          </select>
        </div>

        <div
          class="filter-fx-pedalboard"
          data-filter-pedalboard
          role="group"
          aria-label="Filter presets"
        >
          <button
            class="filter-preset-pedal"
            type="button"
            data-filter-preset-card="clean"
            data-creature="moon-rabbit"
            data-filter-selected="true"
            data-filter-active="false"
            aria-label="Select Clean Filter preset, moon rabbit"
            aria-pressed="true"
            disabled
          >
            <span class="filter-creature-tile" aria-hidden="true">
              <span class="filter-creature-preset">Clean</span>
              <span class="filter-creature-name">Moon Rabbit</span>
              <svg class="filter-creature-portrait" viewBox="0 0 96 78" aria-hidden="true" focusable="false">
                <circle class="creature-accent creature-rabbit-pulse" cx="48" cy="43" r="25"></circle>
                <g class="creature-gesture creature-rabbit">
                  <path d="M38 27 C32 18 32 6 38 5 C44 7 45 20 44 28"></path>
                  <path d="M52 28 C52 16 55 6 61 7 C66 12 61 24 58 31"></path>
                  <path d="M32 51 C32 35 39 27 50 27 C63 27 69 38 67 53 C65 65 36 66 32 51 Z"></path>
                  <path d="M38 58 C40 52 44 50 48 55 C52 49 57 52 60 58"></path>
                  <path d="M42 42 L45 42 M56 42 L59 42 M49 47 L52 47"></path>
                </g>
              </svg>
              <span class="filter-creature-descriptor">Open + clear</span>
              <svg class="filter-creature-response" viewBox="0 0 240 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path data-filter-preview-path d="M12 52 L210 52 Q224 52 228 94"></path>
              </svg>
              <span class="filter-creature-state"></span>
              <span class="filter-creature-preview-values" hidden>
                <span data-filter-preview-control="cutoff" style="--preview-value: 100"></span>
                <span data-filter-preview-control="resonance" style="--preview-value: 0"></span>
                <span data-filter-preview-control="drive" style="--preview-value: 0"></span>
                <span data-filter-preview-control="mix" style="--preview-value: 100"></span>
              </span>
            </span>
          </button>

          <button
            class="filter-preset-pedal"
            type="button"
            data-filter-preset-card="warm"
            data-creature="sleepy-bear"
            data-filter-selected="false"
            data-filter-active="false"
            aria-label="Select Warm Filter preset, sleepy bear"
            aria-pressed="false"
            disabled
          >
            <span class="filter-creature-tile" aria-hidden="true">
              <span class="filter-creature-preset">Warm</span>
              <span class="filter-creature-name">Sleepy Bear</span>
              <svg class="filter-creature-portrait" viewBox="0 0 96 78" aria-hidden="true" focusable="false">
                <g class="creature-gesture creature-bear">
                  <circle cx="33" cy="25" r="8"></circle>
                  <circle cx="63" cy="25" r="8"></circle>
                  <path d="M28 47 C28 30 37 23 48 23 C60 23 68 32 68 48 C68 64 59 69 48 69 C36 69 28 62 28 47 Z"></path>
                  <ellipse cx="48" cy="51" rx="13" ry="11"></ellipse>
                  <path d="M37 40 Q41 44 45 40 M51 40 Q55 44 59 40 M45 51 Q48 54 51 51"></path>
                </g>
                <g class="creature-accent creature-bear-warmth">
                  <path d="M39 17 C35 12 41 10 38 5"></path>
                  <path d="M55 17 C51 12 58 10 55 5"></path>
                </g>
              </svg>
              <span class="filter-creature-descriptor">Soft + round</span>
              <svg class="filter-creature-response" viewBox="0 0 240 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path data-filter-preview-path d="M12 52 L150 52 Q178 52 228 94"></path>
              </svg>
              <span class="filter-creature-state"></span>
              <span class="filter-creature-preview-values" hidden>
                <span data-filter-preview-control="cutoff" style="--preview-value: 68"></span>
                <span data-filter-preview-control="resonance" style="--preview-value: 18"></span>
                <span data-filter-preview-control="drive" style="--preview-value: 14"></span>
                <span data-filter-preview-control="mix" style="--preview-value: 78"></span>
              </span>
            </span>
          </button>

          <button
            class="filter-preset-pedal"
            type="button"
            data-filter-preset-card="bright"
            data-creature="songbird"
            data-filter-selected="false"
            data-filter-active="false"
            aria-label="Select Bright Filter preset, songbird"
            aria-pressed="false"
            disabled
          >
            <span class="filter-creature-tile" aria-hidden="true">
              <span class="filter-creature-preset">Bright</span>
              <span class="filter-creature-name">Songbird</span>
              <svg class="filter-creature-portrait" viewBox="0 0 96 78" aria-hidden="true" focusable="false">
                <g class="creature-gesture creature-bird">
                  <path d="M30 52 C30 37 39 28 52 29 C65 30 70 43 65 55 C61 65 37 65 30 52 Z"></path>
                  <circle cx="58" cy="28" r="12"></circle>
                  <path d="M69 27 L80 31 L69 35 Z M39 45 Q49 38 58 48 Q49 56 39 45 Z"></path>
                  <path d="M43 63 L40 69 M54 63 L57 69 M59 27 L61 27"></path>
                </g>
                <g class="creature-accent creature-bird-chirp">
                  <path d="M74 18 L82 12 M76 24 L88 22 M70 13 L72 4"></path>
                </g>
              </svg>
              <span class="filter-creature-descriptor">Airy + light</span>
              <svg class="filter-creature-response" viewBox="0 0 240 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path data-filter-preview-path d="M12 52 L196 52 Q216 52 228 94"></path>
              </svg>
              <span class="filter-creature-state"></span>
              <span class="filter-creature-preview-values" hidden>
                <span data-filter-preview-control="cutoff" style="--preview-value: 90"></span>
                <span data-filter-preview-control="resonance" style="--preview-value: 10"></span>
                <span data-filter-preview-control="drive" style="--preview-value: 8"></span>
                <span data-filter-preview-control="mix" style="--preview-value: 94"></span>
              </span>
            </span>
          </button>

          <button
            class="filter-preset-pedal"
            type="button"
            data-filter-preset-card="resonant-sweep"
            data-creature="ribbon-snake"
            data-filter-selected="false"
            data-filter-active="false"
            aria-label="Select Resonant Sweep Filter preset, ribbon snake"
            aria-pressed="false"
            disabled
          >
            <span class="filter-creature-tile" aria-hidden="true">
              <span class="filter-creature-preset">Resonant Sweep</span>
              <span class="filter-creature-name">Ribbon Snake</span>
              <svg class="filter-creature-portrait" viewBox="0 0 96 78" aria-hidden="true" focusable="false">
                <path class="creature-snake-body" d="M18 50 C18 25 74 24 74 47 C74 67 31 69 27 53 C24 40 51 35 61 47"></path>
                <g class="creature-gesture creature-snake-head">
                  <path d="M55 42 C61 37 71 39 73 46 C73 53 65 57 58 53 C54 50 53 46 55 42 Z"></path>
                  <path d="M66 46 L68 46 M73 49 L80 47 M73 49 L80 52"></path>
                </g>
                <path class="creature-accent creature-snake-sweep" d="M19 55 C31 70 71 65 77 46"></path>
              </svg>
              <span class="filter-creature-descriptor">Peaked + moving</span>
              <svg class="filter-creature-response" viewBox="0 0 240 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path data-filter-preview-path d="M12 52 L108 52 Q124 10 142 63 Q176 74 228 94"></path>
              </svg>
              <span class="filter-creature-state"></span>
              <span class="filter-creature-preview-values" hidden>
                <span data-filter-preview-control="cutoff" style="--preview-value: 45"></span>
                <span data-filter-preview-control="resonance" style="--preview-value: 64"></span>
                <span data-filter-preview-control="drive" style="--preview-value: 5"></span>
                <span data-filter-preview-control="mix" style="--preview-value: 72"></span>
              </span>
            </span>
          </button>

          <button
            class="filter-preset-pedal"
            type="button"
            data-filter-preset-card="grit"
            data-creature="dragon"
            data-filter-selected="false"
            data-filter-active="false"
            aria-label="Select Grit Filter preset, black-and-white dragon"
            aria-pressed="false"
            disabled
          >
            <span class="filter-creature-tile" aria-hidden="true">
              <span class="filter-creature-preset">Grit</span>
              <span class="filter-creature-name">Black-and-white Dragon</span>
              <svg class="filter-creature-portrait" viewBox="0 0 96 78" aria-hidden="true" focusable="false">
                <g class="creature-gesture creature-dragon">
                  <path class="creature-dragon-tail" d="M35 59 C20 70 10 61 17 51 C21 45 30 48 28 55 C26 61 19 59 20 54"></path>
                  <path class="creature-dragon-silhouette creature-dragon-wing" d="M40 45 L24 25 L27 46 L16 39 L27 61 L42 57 Z"></path>
                  <path class="creature-dragon-silhouette creature-dragon-wing" d="M54 44 L66 25 L67 45 L77 38 L65 60 L52 57 Z"></path>
                  <path class="creature-dragon-silhouette" d="M31 57 C29 44 36 35 47 35 C58 35 64 44 62 57 C60 67 35 68 31 57 Z"></path>
                  <path class="creature-dragon-silhouette creature-dragon-snout" d="M45 42 C46 29 53 22 63 23 L68 17 L69 25 C76 25 81 29 82 34 L89 36 L82 43 L61 43 Z"></path>
                  <path class="creature-dragon-horns" d="M55 25 L51 13 L62 22 M66 23 L71 12 L73 27"></path>
                  <path class="creature-dragon-cutout" d="M38 50 C42 45 53 45 57 51 C55 61 41 63 36 56 Z"></path>
                  <path class="creature-dragon-cutout creature-dragon-eyes-quiet" d="M57 32 L63 32 M68 32 L74 32"></path>
                  <path class="creature-dragon-cutout creature-dragon-brows" d="M56 32 L64 29 M68 29 L76 32"></path>
                  <path class="creature-dragon-cutout creature-dragon-nostril" d="M78 37 L80 37"></path>
                </g>
                <g class="creature-accent creature-dragon-flame">
                  <path class="creature-flame-outer" d="M81 37 C87 34 88 27 94 24 C92 30 97 33 94 38 C91 43 85 42 81 37 Z"></path>
                  <path class="creature-flame-inner" d="M85 37 C89 34 89 31 92 29 C91 33 94 35 91 38 C89 40 87 39 85 37 Z"></path>
                </g>
              </svg>
              <span class="filter-creature-descriptor">Rough + driven</span>
              <svg class="filter-creature-response" viewBox="0 0 240 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path data-filter-preview-path d="M12 52 L140 52 Q166 48 228 94"></path>
              </svg>
              <span class="filter-creature-state"></span>
              <span class="filter-creature-preview-values" hidden>
                <span data-filter-preview-control="cutoff" style="--preview-value: 60"></span>
                <span data-filter-preview-control="resonance" style="--preview-value: 28"></span>
                <span data-filter-preview-control="drive" style="--preview-value: 68"></span>
                <span data-filter-preview-control="mix" style="--preview-value: 76"></span>
              </span>
            </span>
          </button>

          <button
            class="filter-preset-pedal"
            type="button"
            data-filter-preset-card="custom"
            data-creature="chameleon"
            data-filter-selected="false"
            data-filter-active="false"
            aria-label="Select Custom Filter preset, custom patch"
            aria-pressed="false"
            disabled
          >
            <span class="filter-creature-tile" aria-hidden="true">
              <span class="filter-creature-preset">Custom</span>
              <span class="filter-creature-name">Custom Patch</span>
              <svg class="filter-creature-portrait" viewBox="0 0 96 78" aria-hidden="true" focusable="false">
                <path class="custom-patch-grid" d="M12 16H84M12 32H84M12 48H84M12 64H84M24 8V70M40 8V70M56 8V70M72 8V70"></path>
                <path class="custom-patch-signal" d="M12 48H25L31 28L39 58L48 38L56 48H68L75 22L84 48"></path>
                <circle class="custom-patch-node" cx="31" cy="28" r="3"></circle>
                <circle class="custom-patch-node" cx="75" cy="22" r="3"></circle>
              </svg>
              <span class="filter-creature-descriptor">Your four values</span>
              <span class="filter-preset-values" data-filter-custom-values>100 · 0 · 0 · 100</span>
              <svg class="filter-creature-response" viewBox="0 0 240 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path data-filter-preview-path d="M12 52 L210 52 Q224 52 228 94"></path>
              </svg>
              <span class="filter-creature-state"></span>
              <span class="filter-creature-preview-values" hidden>
                <span data-filter-preview-control="cutoff" style="--preview-value: 100"></span>
                <span data-filter-preview-control="resonance" style="--preview-value: 0"></span>
                <span data-filter-preview-control="drive" style="--preview-value: 0"></span>
                <span data-filter-preview-control="mix" style="--preview-value: 100"></span>
              </span>
            </span>
          </button>
        </div>

        <div class="filter-fx-shared-controls" data-filter-shared-controls>
          <div class="filter-fx-shared-header">
            <div>
              <span class="filter-fx-shared-kicker">ONE MASTER FILTER</span>
              <span class="filter-fx-selected-preset" data-filter-selected-label>Clean selected</span>
            </div>
            <button id="filterFxResetBtn" class="filter-fx-action" type="button" disabled>
              Reset
            </button>
          </div>

          <div class="filter-fx-layout">
            <div
              class="filter-fx-graphic"
              id="filterFxGraphic"
              role="img"
              aria-label="Filter response: bypassed. Macro settings are preserved."
            >
              <svg viewBox="0 0 240 120" aria-hidden="true" focusable="false">
                <path class="filter-fx-grid-line" d="M12 92 H228 M12 62 H228 M12 32 H228" />
                <path
                  class="filter-fx-curve-halo"
                  data-filter-curve-halo
                  d="M12 36 L208 36 Q218 36 228 96"
                />
                <path
                  class="filter-fx-curve"
                  id="filterFxCurve"
                  d="M12 36 L208 36 Q218 36 228 96"
                />
              </svg>
              <p class="filter-fx-graphic-state" id="filterFxGraphicState">Bypassed</p>
            </div>

            <fieldset class="filter-fx-macros">
              <legend class="sr-only">Shared Filter controls</legend>

            <div class="filter-fx-macro" data-filter-control="cutoff">
              <div class="filter-fx-macro-heading">
                <label for="filterFxCutoff">Cutoff</label>
                <output
                  id="filterFxCutoffValue"
                  for="filterFxCutoff"
                  data-filter-output="cutoff"
                >18 kHz</output>
              </div>
              <div class="filter-fx-knob" aria-hidden="true">
                <span class="filter-fx-knob-indicator"></span>
              </div>
              <input
                id="filterFxCutoff"
                type="range"
                min="0"
                max="100"
                step="1"
                value="100"
                data-filter-macro="cutoff"
                aria-describedby="filterFxCutoffHint"
                disabled
              />
              <span class="filter-fx-macro-hint" id="filterFxCutoffHint">Dark ↔ Bright</span>
            </div>

            <div class="filter-fx-macro" data-filter-control="resonance">
              <div class="filter-fx-macro-heading">
                <label for="filterFxResonance">Resonance</label>
                <output
                  id="filterFxResonanceValue"
                  for="filterFxResonance"
                  data-filter-output="resonance"
                >0%</output>
              </div>
              <div class="filter-fx-knob" aria-hidden="true">
                <span class="filter-fx-knob-indicator"></span>
              </div>
              <input
                id="filterFxResonance"
                type="range"
                min="0"
                max="100"
                step="1"
                value="0"
                data-filter-macro="resonance"
                aria-describedby="filterFxResonanceHint"
                disabled
              />
              <span class="filter-fx-macro-hint" id="filterFxResonanceHint"
                >Calm ↔ Peaked</span
              >
            </div>

            <div class="filter-fx-macro" data-filter-control="drive">
              <div class="filter-fx-macro-heading">
                <label for="filterFxDrive">Drive</label>
                <output
                  id="filterFxDriveValue"
                  for="filterFxDrive"
                  data-filter-output="drive"
                >0%, Clean</output>
              </div>
              <div class="filter-fx-knob" aria-hidden="true">
                <span class="filter-fx-knob-indicator"></span>
              </div>
              <input
                id="filterFxDrive"
                type="range"
                min="0"
                max="100"
                step="1"
                value="0"
                data-filter-macro="drive"
                aria-describedby="filterFxDriveHint"
                disabled
              />
              <span class="filter-fx-macro-hint" id="filterFxDriveHint">Clean ↔ Driven</span>
            </div>

            <div class="filter-fx-macro" data-filter-control="mix">
              <div class="filter-fx-macro-heading">
                <label for="filterFxMix">Mix</label>
                <output
                  id="filterFxMixValue"
                  for="filterFxMix"
                  data-filter-output="mix"
                >100%, Wet</output>
              </div>
              <div class="filter-fx-knob" aria-hidden="true">
                <span class="filter-fx-knob-indicator"></span>
              </div>
              <input
                id="filterFxMix"
                type="range"
                min="0"
                max="100"
                step="1"
                value="100"
                data-filter-macro="mix"
                aria-describedby="filterFxMixHint"
                disabled
              />
              <span class="filter-fx-macro-hint" id="filterFxMixHint">Dry ↔ Wet</span>
            </div>
            </fieldset>

            <button
              id="filterFxBypassBtn"
              class="filter-fx-action filter-fx-footswitch"
              type="button"
              aria-label="Enable filter"
              aria-pressed="false"
              data-filter-footswitch
              disabled
            >
              Enable filter
            </button>
          </div>
        </div>
        </section>

        <section
          id="spaceFxPanel"
          class="space-fx-panel"
          aria-labelledby="spaceFxTitle"
          aria-describedby="spaceFxHelp"
