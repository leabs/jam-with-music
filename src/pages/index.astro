---
import Layout from "../layouts/Layout.astro";
import ArrangeDialog from "../components/ArrangeDialog.jsx";
import ClearProjectDialog from "../components/ClearProjectDialog.jsx";
import { FiPlay, FiRepeat, FiShare2, FiSquare, FiTrash2, FiVolume2 } from "react-icons/fi";
// Supports weights 300-800
import "@fontsource-variable/open-sans";
---

<Layout>
  <div class="op1-drum-machine container">
    <div class="header-grid">
      <h1 class="app-title">Open Beats</h1>

      <!-- BPM Control -->
      <div class="bpm-control">
        <label for="bpm">BPM:</label>
        <input type="number" id="bpm" value="120" min="40" max="300" />
        <button id="playBtn" type="button">
          <span class="btn-icon" id="playBtnIconPlay"><FiPlay /></span>
          <span class="btn-icon btn-icon-hidden" id="playBtnIconStop">
            <FiSquare />
          </span>
          <span id="playBtnLabel">Play</span>
        </button>
        <button id="loopPatternBtn" type="button" aria-pressed="false">
          <span class="btn-icon"><FiRepeat /></span>
          <span data-loop-label>Loop Pattern</span>
        </button>
        <button id="shareBtn" type="button">
          <span class="btn-icon"><FiShare2 /></span>
          <span>Share</span>
        </button>
        <button id="clearProjectBtn" type="button">
          <span class="btn-icon"><FiTrash2 /></span>
          <span>Clear Project</span>
        </button>
      </div>
    </div>

    <!-- Sequencer (6 rows) -->
    <div class="sequencer">
      <!-- Kick -->
      <div class="sequence-row">
        <div class="instrument-panel">
          <div class="instrument-header">
            <span class="instrument-label">Kick</span>
            <div class="instrument-volume-tooltip-wrap">
              <button
                class="instrument-volume-trigger"
                type="button"
                data-volume-trigger="kick"
                aria-label="Adjust Kick volume"
                title="Adjust Kick volume"
              >
                <span class="instrument-volume-trigger-icon"><FiVolume2 /></span>
                <span data-volume-trigger-value="kick">100%</span>
              </button>
              <div class="instrument-volume-tooltip">
                <input
                  class="instrument-volume-slider"
                  type="range"
                  min="0"
                  max="100"
                  step="10"
                  value="100"
                  data-volume-input="kick"
                  aria-label="Kick volume"
                />
                <span class="instrument-volume-value" data-volume-value="kick">
                  100%
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="all-steps">
          <div class="steps" data-instrument="kick">
            <div class="step" data-step="0"></div>
            <div class="step" data-step="1"></div>
            <div class="step" data-step="2"></div>
            <div class="step" data-step="3"></div>
            <div class="step" data-step="4"></div>
            <div class="step" data-step="5"></div>
            <div class="step" data-step="6"></div>
            <div class="step" data-step="7"></div>
            <div class="step" data-step="8"></div>
            <div class="step" data-step="9"></div>
            <div class="step" data-step="10"></div>
            <div class="step" data-step="11"></div>
            <div class="step" data-step="12"></div>
            <div class="step" data-step="13"></div>
            <div class="step" data-step="14"></div>
            <div class="step" data-step="15"></div>
          </div>
        </div>
      </div>

      <!-- Snare -->
      <div class="sequence-row">
        <div class="instrument-panel">
          <div class="instrument-header">
            <span class="instrument-label">Snare</span>
            <div class="instrument-volume-tooltip-wrap">
              <button
                class="instrument-volume-trigger"
                type="button"
                data-volume-trigger="snare"
                aria-label="Adjust Snare volume"
                title="Adjust Snare volume"
              >
                <span class="instrument-volume-trigger-icon"><FiVolume2 /></span>
                <span data-volume-trigger-value="snare">100%</span>
              </button>
              <div class="instrument-volume-tooltip">
                <input
                  class="instrument-volume-slider"
                  type="range"
                  min="0"
                  max="100"
                  step="10"
                  value="100"
                  data-volume-input="snare"
                  aria-label="Snare volume"
                />
                <span class="instrument-volume-value" data-volume-value="snare">
                  100%
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="all-steps">
          <div class="steps" data-instrument="snare">
            <div class="step" data-step="0"></div>
            <div class="step" data-step="1"></div>
            <div class="step" data-step="2"></div>
            <div class="step" data-step="3"></div>
            <div class="step" data-step="4"></div>
            <div class="step" data-step="5"></div>
            <div class="step" data-step="6"></div>
            <div class="step" data-step="7"></div>
            <div class="step" data-step="8"></div>
            <div class="step" data-step="9"></div>
            <div class="step" data-step="10"></div>
            <div class="step" data-step="11"></div>
            <div class="step" data-step="12"></div>
            <div class="step" data-step="13"></div>
            <div class="step" data-step="14"></div>
            <div class="step" data-step="15"></div>
          </div>
        </div>
      </div>

      <!-- Hi-Hat -->
      <div class="sequence-row">
        <div class="instrument-panel">
          <div class="instrument-header">
            <span class="instrument-label">Hi-Hat</span>
            <div class="instrument-volume-tooltip-wrap">
              <button
                class="instrument-volume-trigger"
                type="button"
                data-volume-trigger="hi_hat"
                aria-label="Adjust Hi-Hat volume"
                title="Adjust Hi-Hat volume"
              >
                <span class="instrument-volume-trigger-icon"><FiVolume2 /></span>
                <span data-volume-trigger-value="hi_hat">100%</span>
              </button>
              <div class="instrument-volume-tooltip">
                <input
                  class="instrument-volume-slider"
                  type="range"
                  min="0"
                  max="100"
                  step="10"
                  value="100"
                  data-volume-input="hi_hat"
                  aria-label="Hi-Hat volume"
                />
                <span class="instrument-volume-value" data-volume-value="hi_hat">
                  100%
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="all-steps">
          <div class="steps" data-instrument="hi_hat">
            <div class="step" data-step="0"></div>
            <div class="step" data-step="1"></div>
            <div class="step" data-step="2"></div>
            <div class="step" data-step="3"></div>
            <div class="step" data-step="4"></div>
            <div class="step" data-step="5"></div>
            <div class="step" data-step="6"></div>
            <div class="step" data-step="7"></div>
            <div class="step" data-step="8"></div>
            <div class="step" data-step="9"></div>
            <div class="step" data-step="10"></div>
            <div class="step" data-step="11"></div>
            <div class="step" data-step="12"></div>
            <div class="step" data-step="13"></div>
            <div class="step" data-step="14"></div>
            <div class="step" data-step="15"></div>
          </div>
        </div>
      </div>

      <!-- Clap -->
      <div class="sequence-row">
        <div class="instrument-panel">
          <div class="instrument-header">
            <span class="instrument-label">Clap</span>
            <div class="instrument-volume-tooltip-wrap">
              <button
                class="instrument-volume-trigger"
                type="button"
                data-volume-trigger="clap"
                aria-label="Adjust Clap volume"
                title="Adjust Clap volume"
              >
                <span class="instrument-volume-trigger-icon"><FiVolume2 /></span>
                <span data-volume-trigger-value="clap">100%</span>
              </button>
              <div class="instrument-volume-tooltip">
                <input
                  class="instrument-volume-slider"
                  type="range"
                  min="0"
                  max="100"
                  step="10"
                  value="100"
                  data-volume-input="clap"
                  aria-label="Clap volume"
                />
                <span class="instrument-volume-value" data-volume-value="clap">
                  100%
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="all-steps">
          <div class="steps" data-instrument="clap">
            <div class="step" data-step="0"></div>
            <div class="step" data-step="1"></div>
            <div class="step" data-step="2"></div>
            <div class="step" data-step="3"></div>
            <div class="step" data-step="4"></div>
            <div class="step" data-step="5"></div>
            <div class="step" data-step="6"></div>
            <div class="step" data-step="7"></div>
            <div class="step" data-step="8"></div>
            <div class="step" data-step="9"></div>
            <div class="step" data-step="10"></div>
            <div class="step" data-step="11"></div>
            <div class="step" data-step="12"></div>
            <div class="step" data-step="13"></div>
            <div class="step" data-step="14"></div>
            <div class="step" data-step="15"></div>
          </div>
        </div>
      </div>

      <!-- tom -->
      <div class="sequence-row">
        <div class="instrument-panel">
          <div class="instrument-header">
            <span class="instrument-label">Tom</span>
            <div class="instrument-volume-tooltip-wrap">
              <button
                class="instrument-volume-trigger"
                type="button"
                data-volume-trigger="tom"
                aria-label="Adjust Tom volume"
                title="Adjust Tom volume"
              >
                <span class="instrument-volume-trigger-icon"><FiVolume2 /></span>
                <span data-volume-trigger-value="tom">100%</span>
              </button>
              <div class="instrument-volume-tooltip">
                <input
                  class="instrument-volume-slider"
                  type="range"
                  min="0"
                  max="100"
                  step="10"
                  value="100"
                  data-volume-input="tom"
                  aria-label="Tom volume"
                />
                <span class="instrument-volume-value" data-volume-value="tom">
                  100%
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="all-steps">
          <div class="steps" data-instrument="tom">
            <div class="step" data-step="0"></div>
            <div class="step" data-step="1"></div>
            <div class="step" data-step="2"></div>
            <div class="step" data-step="3"></div>
            <div class="step" data-step="4"></div>
            <div class="step" data-step="5"></div>
            <div class="step" data-step="6"></div>
            <div class="step" data-step="7"></div>
            <div class="step" data-step="8"></div>
            <div class="step" data-step="9"></div>
            <div class="step" data-step="10"></div>
            <div class="step" data-step="11"></div>
            <div class="step" data-step="12"></div>
            <div class="step" data-step="13"></div>
            <div class="step" data-step="14"></div>
            <div class="step" data-step="15"></div>
          </div>
        </div>
      </div>

      <!-- Rattle -->
      <div class="sequence-row">
        <div class="instrument-panel">
          <div class="instrument-header">
            <span class="instrument-label">Rattle</span>
            <div class="instrument-volume-tooltip-wrap">
              <button
                class="instrument-volume-trigger"
                type="button"
                data-volume-trigger="rattle"
                aria-label="Adjust Rattle volume"
                title="Adjust Rattle volume"
              >
                <span class="instrument-volume-trigger-icon"><FiVolume2 /></span>
                <span data-volume-trigger-value="rattle">100%</span>
              </button>
              <div class="instrument-volume-tooltip">
                <input
                  class="instrument-volume-slider"
                  type="range"
                  min="0"
                  max="100"
                  step="10"
                  value="100"
                  data-volume-input="rattle"
                  aria-label="Rattle volume"
                />
                <span class="instrument-volume-value" data-volume-value="rattle">
                  100%
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="all-steps">
          <div class="steps" data-instrument="rattle">
            <div class="step" data-step="0"></div>
            <div class="step" data-step="1"></div>
            <div class="step" data-step="2"></div>
            <div class="step" data-step="3"></div>
            <div class="step" data-step="4"></div>
            <div class="step" data-step="5"></div>
            <div class="step" data-step="6"></div>
            <div class="step" data-step="7"></div>
            <div class="step" data-step="8"></div>
            <div class="step" data-step="9"></div>
            <div class="step" data-step="10"></div>
            <div class="step" data-step="11"></div>
            <div class="step" data-step="12"></div>
            <div class="step" data-step="13"></div>
            <div class="step" data-step="14"></div>
            <div class="step" data-step="15"></div>
          </div>
        </div>
      </div>
    </div>

    <ArrangeDialog client:load />
    <ClearProjectDialog client:load />
  </div>
</Layout>

<style>
  :root {
    --daw-bg: #080808;
    --daw-panel: #1c1612;
    --daw-panel-2: #2a211a;
    --daw-border: #4b3a2f;
    --daw-text: #f7f2ed;
    --daw-muted: #b2a398;
    --daw-accent: #f59e0b;
    --daw-accent-2: #fb923c;
    --daw-accent-3: #fdba74;
    --pad-off: #3a3028;
    --pad-off-hi: #514136;
    --pad-active: #f97316;
    --pad-active-hi: #fdba74;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background:
      radial-gradient(circle at 10% -5%, rgba(251, 146, 60, 0.2), transparent 38%),
      radial-gradient(circle at 100% 0%, rgba(245, 158, 11, 0.14), transparent 35%),
      var(--daw-bg);
    color: var(--daw-text);
    font-family: "Open Sans Variable", sans-serif;
    width: 100%;
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 14px 28px;
  }

  .op1-drum-machine {
    width: 100%;
    padding: 18px;
    background:
      radial-gradient(circle at 14% 0%, rgba(251, 146, 60, 0.16), transparent 34%),
      radial-gradient(circle at 85% 2%, rgba(245, 158, 11, 0.1), transparent 30%),
      linear-gradient(180deg, #14100d, #0b0908);
    border-radius: 0;
    box-shadow:
      0 26px 70px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      inset 0 -16px 30px rgba(0, 0, 0, 0.28);
  }

  h1,
  h2 {
    font-weight: 600;
  }

  p,
  a,
  label,
  .instrument-label {
    font-weight: 400;
    color: var(--daw-muted);
  }

  .op1-drum-machine h1 {
    text-align: left;
    margin: 0;
  }

  .app-title {
    font-family: "Open Sans Variable", sans-serif;
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff7ed;
  }

  .header-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 4px;
    margin-bottom: 12px;
  }

  .bpm-control {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    background: linear-gradient(180deg, rgba(44, 30, 20, 0.9), rgba(30, 21, 15, 0.92));
    border-radius: 8px;
    padding: 8px 10px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      inset 0 -1px 0 rgba(0, 0, 0, 0.35);
  }

  .bpm-control label {
    margin-right: 0;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #e7d9cc;
  }

  #bpm {
    width: 72px;
    text-align: center;
    background: #15100c;
    color: #fff7ed;
    border: none;
    border-radius: 4px;
    font-size: 15px;
    padding: 6px 4px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      inset 0 -1px 0 rgba(0, 0, 0, 0.45);
  }

  #bpm:focus {
    outline: 2px solid rgba(251, 146, 60, 0.5);
    border-color: var(--daw-accent-2);
  }

  #playBtn,
  #shareBtn,
  #loopPatternBtn,
  #clearProjectBtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    color: #fafafa;
    padding: 8px 13px;
    border-radius: 4px;
    border: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: all 0.15s ease;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4);
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    line-height: 1;
  }

  .btn-icon-hidden {
    display: none;
  }

  #playBtn {
    background: linear-gradient(180deg, #fdba74, #f97316);
    color: #1f1308;
  }

  #playBtn:hover {
    filter: brightness(1.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 0 0 2px rgba(251, 146, 60, 0.3);
    transform: translateY(-1px);
  }

  #shareBtn {
    background: linear-gradient(180deg, #4a3a31, #342922);
  }

  #loopPatternBtn {
    background: linear-gradient(180deg, #4a3a31, #342922);
  }

  #shareBtn:hover {
    background: linear-gradient(180deg, #5b463a, #443329);
    color: #fff;
  }

  #loopPatternBtn:hover {
    background: linear-gradient(180deg, #5b463a, #443329);
    color: #fff;
  }

  #loopPatternBtn.is-active {
    background: linear-gradient(180deg, #fb923c, #c2410c);
    color: #241106;
  }

  #loopPatternBtn.is-active:hover {
    background: linear-gradient(180deg, #fdba74, #ea580c);
    color: #241106;
  }

  #playBtn:active,
  #shareBtn:active,
  #loopPatternBtn:active,
  #clearProjectBtn:active {
    transform: translateY(0);
  }

  #clearProjectBtn {
    background: linear-gradient(180deg, #7f1d1d, #450a0a);
    color: #fecaca;
  }

  #clearProjectBtn:hover {
    background: linear-gradient(180deg, #991b1b, #5f0f0f);
    color: #fee2e2;
  }

  .sequencer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background:
      linear-gradient(180deg, rgba(34, 26, 20, 0.9), rgba(20, 15, 12, 0.92));
    border-radius: 8px;
    padding: 14px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      inset 0 -1px 0 rgba(0, 0, 0, 0.45);
  }

  .sequence-row {
    display: grid;
    grid-template-columns: 170px 1fr;
    align-items: center;
    gap: 12px;
    background: linear-gradient(180deg, rgba(74, 56, 42, 0.28), rgba(40, 30, 23, 0.26));
    border-radius: 6px;
    padding: 8px;
  }

  .instrument-panel {
    padding: 8px 10px;
    border-radius: 4px;
    background: linear-gradient(180deg, #4a382d, #2f241d);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      inset 0 -1px 0 rgba(0, 0, 0, 0.45);
  }

  .instrument-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .instrument-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: #f6e7dc;
    font-weight: 700;
    text-align: left;
  }

  .instrument-volume-tooltip-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .instrument-volume-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: 1px solid rgba(161, 98, 7, 0.55);
    background: linear-gradient(180deg, rgba(69, 51, 38, 0.95), rgba(40, 30, 23, 0.95));
    color: #fed7aa;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 3px 6px;
    border-radius: 3px;
    cursor: pointer;
    transition: border-color 0.14s ease, color 0.14s ease;
  }

  .instrument-volume-trigger:hover,
  .instrument-volume-trigger:focus-visible {
    border-color: rgba(251, 146, 60, 0.85);
    color: #fff7ed;
    outline: none;
  }

  .instrument-volume-trigger-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-size: 0.72rem;
  }

  .instrument-volume-tooltip {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    width: 150px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border: 1px solid rgba(113, 63, 18, 0.8);
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(31, 23, 18, 0.98), rgba(20, 15, 12, 0.98));
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.55);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-3px);
    transition: opacity 0.12s ease, transform 0.12s ease;
    z-index: 18;
  }

  .instrument-volume-tooltip-wrap:hover .instrument-volume-tooltip,
  .instrument-volume-tooltip-wrap:focus-within .instrument-volume-tooltip {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .instrument-volume-slider {
    width: 100%;
    accent-color: #f97316;
    cursor: pointer;
  }

  .instrument-volume-value {
    min-width: 34px;
    text-align: right;
    font-size: 0.72rem;
    font-weight: 600;
    color: #fed7aa;
  }

  .all-steps {
    width: 100%;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(16, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
  }

  .step {
    background: linear-gradient(180deg, var(--pad-off-hi), var(--pad-off));
    border: none;
    border-radius: 3px;
    cursor: pointer;
    aspect-ratio: 1 / 1;
    transition: transform 0.09s ease, filter 0.12s ease, box-shadow 0.12s ease;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -2px 0 rgba(0, 0, 0, 0.5),
      0 4px 10px rgba(0, 0, 0, 0.35);
  }

  .step:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .step:nth-child(4n + 1) {
    background: linear-gradient(180deg, #6a4f3a, #4d3829);
    box-shadow:
      inset 0 2px 0 rgba(251, 146, 60, 0.72),
