</style>

<script>
  import {
    DEFAULT_BPM,
    getSixteenthNoteDurationSeconds,
    normalizeBpm,
  } from "../lib/sequencer-safety.js";
  import {
    FILTER_SONG_SCHEMA_VERSION,
    createDefaultFilterEffectState,
    deserializeFilterEffectState,
    formatFilterMacroValue,
    getFilterEffectPresetState,
    getFilterGraphicSummary,
    normalizeFilterEffectState,
    serializeFilterEffectState,
  } from "../lib/filter-effect.js";
  import { createMasterEffectsChain } from "../lib/master-effects-chain.js";
  import {
    createDefaultSpaceEffectState,
    deserializeSpaceEffectState,
    formatSpaceMacroValue,
    getSpaceEffectSummary,
    getSpaceEffectPresetState,
    normalizeSpaceEffectState,
    serializeSpaceEffectState,
  } from "../lib/space-effect.js";

  /************************************************
   * Drum machine
   ************************************************/
  let audioCtx = null;
  let audioInitializationError = null;
  try {
    const AudioContextConstructor = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextConstructor) {
      throw new Error("Web Audio API is not supported in this browser.");
    }
    audioCtx = new AudioContextConstructor();
  } catch (e) {
    audioInitializationError = e;
  }

  const instrumentsOrder = [
    "kick",
    "snare",
    "hi_hat",
    "clap",
    "rattle",
    "tom",
    "ring",
    "undertaker",
    "hit",
    "huh",
    "itemdrop",
    "codex",
    "exclamation",
    "thatnoise",
  ];

  const sampleURLs = {
    kick: "kick.mp3",
    snare: "snare.mp3",
    hi_hat: "hi_hat.mp3",
    clap: "clap.mp3",
    rattle: "rattle.mp3",
    tom: "tom.mp3",
    ring: "ring.mp3",
    undertaker: "undertaker.mp3",
    hit: "hit.mp3",
    huh: "huh.mp3",
    itemdrop: "itemdrop.mp3",
    codex: "codec.mp3",
    exclamation: "exclamation.mp3",
    thatnoise: "thatnoise.mp3",
  };

  const STEPS_PER_PATTERN = 16;
  const BYTES_PER_PATTERN = instrumentsOrder.length * 2;
  const MAX_PATTERN_REPEATS = 128;
  const DEFAULT_INSTRUMENT_VOLUME_PERCENT = 100;
  const INSTRUMENT_VOLUME_STEP_PERCENT = 10;
  const PITCH_MIN_SEMITONES = -7;
  const PITCH_MAX_SEMITONES = 7;
  const PITCH_LEVELS = Array.from(
    { length: PITCH_MAX_SEMITONES - PITCH_MIN_SEMITONES + 1 },
    function (_, index) {
      return PITCH_MAX_SEMITONES - index;
    }
  );
  const scheduleInterval = 25; // ms
  const MAX_SCHEDULER_STEPS_PER_TICK = 64;
  const MAX_SCHEDULER_LAG_SECONDS = 0.1;
  const SAMPLE_FETCH_TIMEOUT_MS = 15000;

  const audioBuffers = {};
  const sampleLoadStates = {};
  const sampleLoadPromises = {};
  const scheduledSources = new Map();
  const retiringSources = new Map();
  const scheduledHighlightTimers = new Set();
  let masterGainNode = null;
  let masterProtectionNode = null;
  let masterOutputDestination = null;
  let masterFilterGraph = null;
  let masterEffectsChain = null;
  let blockedMasterEffectsChain = null;
  let filterTransportClosePromise = Promise.resolve(true);
  let filterEffectState = createDefaultFilterEffectState();
  let spaceEffectState = createDefaultSpaceEffectState();
  let spaceEffectAvailable = true;
  function refreshEffectsAvailability() {
    if (!masterEffectsChain) {
      filterEffectAvailable = false;
      spaceEffectAvailable = false;
      return;
    }
    const availability = masterEffectsChain.getAvailability();
    filterEffectAvailable = availability.tone;
    spaceEffectAvailable = availability.space;
    masterFilterGraph = masterEffectsChain.toneGraph;
  }
  function retireMasterEffectsChain(failedChain) {
    try { masterGainNode?.disconnect(); } catch (_disconnectError) {}
    try { masterProtectionNode?.disconnect(); } catch (_disconnectError) {}
    try {
      failedChain?.disconnect();
      if (blockedMasterEffectsChain === failedChain) blockedMasterEffectsChain = null;
    } catch (_disconnectError) {
      blockedMasterEffectsChain = failedChain;
    }
    if (masterEffectsChain === failedChain) masterEffectsChain = null;
    masterFilterGraph = null;
    masterGainNode = null;
    masterProtectionNode = null;
    masterOutputDestination = null;
    filterEffectAvailable = false;
    spaceEffectAvailable = false;
  }
  const spaceController = Object.freeze({
    setState(nextState, options) {
      spaceEffectState = normalizeSpaceEffectState(nextState);
      if (masterEffectsChain) {
        const applyingChain = masterEffectsChain;
        void applyingChain.applySpaceState(spaceEffectState, {
          immediate: Boolean(options && options.immediate),
        }).then(function (result) {
          if (masterEffectsChain !== applyingChain) return;
          refreshEffectsAvailability();
          renderFilterEffectUi();
          renderSpaceEffectUi();
          return result;
        }).catch(function () {
          if (masterEffectsChain !== applyingChain) return;
          retireMasterEffectsChain(applyingChain);
          renderFilterEffectUi();
          renderSpaceEffectUi();
        });
      }
      renderSpaceEffectUi();
      return { ...spaceEffectState };
    },
    replaceWithDefault(options) {
      return this.setState(createDefaultSpaceEffectState(), options);
    },
    selectPreset(presetId, options) {
      return this.setState(getSpaceEffectPresetState(presetId), options);
    },
    setMacro(control, value, options) {
      if (!["size", "decay", "air", "mix"].includes(control)) return this.getState();
      return this.setState({ ...spaceEffectState, [control]: value, preset: "custom" }, options);
    },
    setEnabled(enabled, options) {
      return this.setState({ ...spaceEffectState, enabled: Boolean(enabled) }, options);
    },
    makeUnavailable() {
      spaceEffectAvailable = false;
      let result = null;
      try {
        result = masterEffectsChain ? masterEffectsChain.makeSpaceUnavailable() : null;
      } catch (_error) {
        const failedChain = masterEffectsChain;
        retireMasterEffectsChain(failedChain);
      }
      refreshEffectsAvailability();
      renderSpaceEffectUi();
      return result;
    },
    getState() { return { ...spaceEffectState }; },
    render() {
      refreshEffectsAvailability();
      renderSpaceEffectUi();
      return this.getState();
    },
  });
  let filterEffectAvailable = true;
  let filterPanelExpanded = false;
  let filterPanelTransitionGeneration = 0;
  let filterPanelHideTimerId = null;
  let filterPanelTransitionEndHandler = null;
  let filterControlsBound = false;
  const FILTER_PANEL_TRANSITION_MS = 180;
  const DUPLICATE_PATTERN_ICON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const DELETE_PATTERN_ICON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>';

  const bpmInput = document.getElementById("bpm");
  const playBtn = document.getElementById("playBtn");
  const playBtnLabel = document.getElementById("playBtnLabel");
  const playBtnIconPlay = document.getElementById("playBtnIconPlay");
  const playBtnIconStop = document.getElementById("playBtnIconStop");
  const shareBtn = document.getElementById("shareBtn");
  const loopPatternBtn = document.getElementById("loopPatternBtn");
  const loopPatternBtnLabel = document.querySelector("#loopPatternBtn [data-loop-label]");
  const clearProjectBtn = document.getElementById("clearProjectBtn");
  const mobileHelpBtn = document.getElementById("mobileHelpBtn");
  const mobileHelpWrap = document.querySelector(".mobile-help-wrap");
  const audioStatus = document.getElementById("audioStatus");
  const retrySamplesBtn = document.getElementById("retrySamplesBtn");
  const instrumentScreen = document.getElementById("instrumentScreen");
  const instrumentScreenBpm = document.querySelector("[data-screen-bpm]");
  const instrumentScreenMode = document.querySelector("[data-screen-mode]");
  const instrumentScreenFilter = document.querySelector("[data-screen-filter]");
  const filterFxPanel = document.getElementById("filterFxPanel");
  const filterFxToggle = document.getElementById("filterFxToggle");
  const filterFxToggleLabel = document.querySelector("[data-filter-toggle-label]");
  const filterFxBody = document.getElementById("filterFxBody");
  const filterFxStatus = document.getElementById("filterFxStatus");
  const toneFxStatus = document.getElementById("toneFxStatus");
  const filterFxActionStatus = document.getElementById("filterFxActionStatus");
  const filterFxBypassBtn = document.getElementById("filterFxBypassBtn");
  const filterFxPreset = document.getElementById("filterFxPreset");
  const filterFxPresetCards = Array.from(
    document.querySelectorAll("[data-filter-preset-card]")
  );
  const filterFxSelectedLabel = document.querySelector("[data-filter-selected-label]");
  const filterFxResetBtn = document.getElementById("filterFxResetBtn");
  const filterFxGraphic = document.getElementById("filterFxGraphic");
  const filterFxCurve = document.getElementById("filterFxCurve");
  const filterFxCurveHalo = document.querySelector("[data-filter-curve-halo]");
  const filterFxGraphicState = document.getElementById("filterFxGraphicState");
  const filterFxMacroInputs = Array.from(
    document.querySelectorAll("[data-filter-macro]")
  );
  const filterFxMacroOutputs = Array.from(
    document.querySelectorAll("[data-filter-output]")
  );
  const spaceFxPanel = document.getElementById("spaceFxPanel");
  const spaceFxStatus = document.getElementById("spaceFxStatus");
  const spaceFxSummary = document.querySelector("[data-space-summary]");
  const spaceFxBypassBtn = document.getElementById("spaceFxBypassBtn");
  const spaceFxPresetCards = Array.from(document.querySelectorAll("[data-space-preset]"));
  const spaceFxMacroInputs = Array.from(document.querySelectorAll("[data-space-macro]"));
  const spaceFxMacroOutputs = Array.from(document.querySelectorAll("[data-space-output]"));
  const pitchRollDialog = document.getElementById("pitchRollDialog");
  const pitchRollTitle = document.getElementById("pitchRollTitle");
  const pitchRollGrid = document.getElementById("pitchRollGrid");
  const pitchRollCloseBtn = document.getElementById("pitchRollCloseBtn");
  const pitchRollResetBtn = document.getElementById("pitchRollResetBtn");

  let patternList = null;
  let newPatternBtn = null;
  let clearPatternBtn = null;

  let isPlaying = false;
  let isStartingPlayback = false;
  let isRetryingSamples = false;
  let playbackStartRequestId = 0;
  let playbackAudioError = null;
  let current16th = 0;
  let nextNoteTime = 0;
  let schedulerIntervalId = null;
  let playbackPatternIndex = 0;
  let stepsInPlaybackPattern = 0;

  let patterns = [createEmptyPatternBytes()];
  let patternRepeats = [1];
  let patternPitchOffsets = [createDefaultPatternPitchOffsets()];
  let instrumentVolumes = createDefaultInstrumentVolumes();
  let selectedPatternIndex = 0;
  let loopPatternMode = false;
  let arrangementControlsBound = false;
  let draggedPatternIndex = null;
  let patternDropIndicator = null;
  let pendingDropInsertIndex = null;
  const instrumentVolumeInputs = {};
  const instrumentVolumeValues = {};
  const instrumentVolumeTriggers = {};
  const instrumentVolumeWraps = {};
  let instrumentVolumeDismissBound = false;
  let pitchRollBound = false;
  let activePitchInstrument = null;
  let pitchRollReturnFocusElement = null;

  instrumentsOrder.forEach(function (instrument) {
    sampleLoadStates[instrument] = "idle";
  });

  function getFilterCurvePath(state) {
    const kneeX = 28 + (state.cutoff / 100) * 176;
    const peakY = 36 - (state.resonance / 100) * 24;
    const shoulderX = Math.min(220, kneeX + 18);
    return [
      "M12 36",
      "L" + Math.max(12, kneeX - 16).toFixed(1) + " 36",
      "Q" + (kneeX - 5).toFixed(1) + " 36 " + kneeX.toFixed(1) + " " + peakY.toFixed(1),
      "Q" + (kneeX + 8).toFixed(1) + " 38 " + shoulderX.toFixed(1) + " 54",
      "Q" + Math.min(226, shoulderX + 8).toFixed(1) + " 74 228 96",
    ].join(" ");
  }

  function getFilterPresetDisplayName(presetId) {
    if (presetId === "resonant-sweep") return "Resonant Sweep";
    if (presetId === "custom") return "Custom";
    return presetId.charAt(0).toUpperCase() + presetId.slice(1);
  }

  function renderInstrumentScreen(stepIndex) {
    if (!instrumentScreen) return;
    const bpm = normalizeBpm(bpmInput ? bpmInput.value : DEFAULT_BPM, DEFAULT_BPM);
    const state = normalizeFilterEffectState(filterEffectState);
    const screenStep = Number.isFinite(stepIndex)
      ? Math.min(STEPS_PER_PATTERN - 1, Math.max(0, Math.trunc(stepIndex)))
      : Number(instrumentScreen.dataset.step || 0);
    const mode = isPlaying ? "PLAYING" : isStartingPlayback ? "STARTING" : "STOPPED";
    const filterLabel = !filterEffectAvailable
      ? "FILTER UNAVAILABLE"
      : state.enabled
        ? getFilterPresetDisplayName(state.preset).toUpperCase() + " FILTER ON"
        : "FILTER BYPASSED";

    instrumentScreen.dataset.playing = isPlaying ? "true" : "false";
    instrumentScreen.dataset.filterActive =
      filterEffectAvailable && state.enabled ? "true" : "false";
    instrumentScreen.dataset.step = screenStep.toString();
    instrumentScreen.dataset.tick = screenStep % 2 === 0 ? "even" : "odd";
    instrumentScreen.style.setProperty("--screen-step", screenStep.toString());
    instrumentScreen.style.setProperty(
      "--screen-position",
      ((screenStep / (STEPS_PER_PATTERN - 1)) * 100).toFixed(3) + "%"
    );
    instrumentScreen.setAttribute(
      "aria-label",
      (isPlaying ? "Playing" : isStartingPlayback ? "Starting" : "Stopped") +
        ", " +
        bpm +
        " BPM, " +
        filterLabel.toLowerCase() +
        "."
    );
    if (instrumentScreenBpm) instrumentScreenBpm.textContent = bpm.toString();
    if (instrumentScreenMode) instrumentScreenMode.textContent = mode;
    if (instrumentScreenFilter) instrumentScreenFilter.textContent = filterLabel;
    if (playBtn) playBtn.dataset.mode = isPlaying ? "stop" : "play";
  }

  function renderFilterEffectUi() {
    const state = normalizeFilterEffectState(filterEffectState);
    const controlsDisabled = !filterEffectAvailable;
    const effectiveEnabled = filterEffectAvailable && state.enabled;
    const graphicSummary = getFilterGraphicSummary({
      ...state,
      enabled: effectiveEnabled,
    });

    if (filterFxPanel) {
      filterFxPanel.dataset.enabled = effectiveEnabled ? "true" : "false";
      filterFxPanel.dataset.available = filterEffectAvailable ? "true" : "false";
      filterFxPanel.dataset.preset = state.preset;
      filterFxPanel.style.setProperty("--filter-drive", state.drive.toString());
      filterFxPanel.style.setProperty("--filter-mix", state.mix.toString());
      filterFxPanel.style.setProperty(
        "--filter-dash",
        effectiveEnabled && state.drive >= 60 ? "7 2" : "none"
      );
    }
    const toneStatus = !filterEffectAvailable
      ? "Unavailable"
      : state.enabled ? "On" : "Bypassed";
    if (toneFxStatus && toneFxStatus.textContent !== toneStatus) {
      toneFxStatus.textContent = toneStatus;
    }
    if (filterFxStatus) {
      const spaceStatus = !spaceEffectAvailable
        ? "Unavailable"
        : spaceEffectState.enabled ? "On" : "Bypassed";
      const statusMessage = "Tone: " + toneStatus + " · Space: " + spaceStatus;
      if (filterFxStatus.textContent !== statusMessage) {
        filterFxStatus.textContent = statusMessage;
      }
    }
    if (filterFxBypassBtn) {
      filterFxBypassBtn.disabled = controlsDisabled;
      filterFxBypassBtn.setAttribute("aria-pressed", effectiveEnabled ? "true" : "false");
      filterFxBypassBtn.setAttribute(
        "aria-label",
        filterEffectAvailable
          ? effectiveEnabled
            ? "Bypass filter"
            : "Enable filter"
          : "Filter unavailable; audio is bypassed"
      );
      filterFxBypassBtn.textContent = filterEffectAvailable
        ? effectiveEnabled
          ? "Bypass filter"
          : "Enable filter"
        : "Filter unavailable";
    }
    if (filterFxPreset) {
      filterFxPreset.disabled = controlsDisabled;
      filterFxPreset.value = state.preset;
    }
    filterFxPresetCards.forEach(function (card) {
      const presetId = card.dataset.filterPresetCard;
      if (!presetId) return;

      const selected = presetId === state.preset;
      const active = selected && effectiveEnabled;
      const previewState =
        presetId === "custom" ? state : getFilterEffectPresetState(presetId);

      card.disabled = controlsDisabled;
      card.dataset.filterSelected = selected ? "true" : "false";
      card.dataset.filterActive = active ? "true" : "false";
      card.setAttribute("aria-pressed", selected ? "true" : "false");

      if (!previewState) return;
      card.querySelectorAll("[data-filter-preview-control]").forEach(function (knob) {
        const control = knob.dataset.filterPreviewControl;
        if (!control || !(control in previewState)) return;
        knob.style.setProperty("--preview-value", previewState[control].toString());
      });
      const previewPath = card.querySelector("[data-filter-preview-path]");
      if (previewPath) {
        previewPath.setAttribute("d", getFilterCurvePath(previewState));
      }
      if (presetId === "custom") {
        const customValues = card.querySelector("[data-filter-custom-values]");
        if (customValues) {
          customValues.textContent = [
            previewState.cutoff,
            previewState.resonance,
            previewState.drive,
            previewState.mix,
          ].join(" · ");
        }
      }
    });
    if (filterFxSelectedLabel) {
      filterFxSelectedLabel.textContent =
        getFilterPresetDisplayName(state.preset) + " selected";
    }
    if (filterFxResetBtn) {
      filterFxResetBtn.disabled = controlsDisabled;
    }

    filterFxMacroInputs.forEach(function (input) {
      const control = input.dataset.filterMacro;
      if (!control || !(control in state)) return;
      const value = state[control];
      input.disabled = controlsDisabled;
      input.value = value.toString();
      input.setAttribute(
        "aria-valuetext",
        formatFilterMacroValue(control, value, true) + ", " + value + " of 100"
      );
      const card = input.closest(".filter-fx-macro");
      if (card) {
        card.style.setProperty("--filter-value", value.toString());
      }
    });
    filterFxMacroOutputs.forEach(function (output) {
      const control = output.dataset.filterOutput;
      if (!control || !(control in state)) return;
      output.textContent = formatFilterMacroValue(control, state[control], false);
    });

    const curvePath = getFilterCurvePath(state);
    if (filterFxCurve) filterFxCurve.setAttribute("d", curvePath);
    if (filterFxCurveHalo) filterFxCurveHalo.setAttribute("d", curvePath);
    if (filterFxGraphic) {
      filterFxGraphic.setAttribute(
        "aria-label",
        filterEffectAvailable
          ? graphicSummary.description
          : "Filter unavailable. Audio is using the neutral protected path."
      );
    }
    if (filterFxGraphicState) {
      filterFxGraphicState.textContent = filterEffectAvailable
        ? graphicSummary.label
        : "Filter unavailable · Neutral audio";
    }
    renderInstrumentScreen();
  }

  function renderSpaceEffectUi() {
    const state = normalizeSpaceEffectState(spaceEffectState);
    const controlsDisabled = !spaceEffectAvailable;
    const effectiveEnabled = spaceEffectAvailable && state.enabled;
    if (spaceFxPanel) {
      spaceFxPanel.dataset.enabled = effectiveEnabled ? "true" : "false";
      spaceFxPanel.dataset.available = spaceEffectAvailable ? "true" : "false";
      spaceFxPanel.dataset.preset = state.preset;
    }
    if (spaceFxStatus) {
      spaceFxStatus.textContent = spaceEffectAvailable
        ? effectiveEnabled ? "On" : "Bypassed"
        : "Space unavailable; audio is bypassed.";
    }
    if (spaceFxSummary) spaceFxSummary.textContent = getSpaceEffectSummary(state);
    if (spaceFxBypassBtn) {
      spaceFxBypassBtn.disabled = controlsDisabled;
      spaceFxBypassBtn.setAttribute("aria-pressed", effectiveEnabled ? "true" : "false");
      spaceFxBypassBtn.setAttribute("aria-label", spaceEffectAvailable
        ? effectiveEnabled ? "Bypass Space" : "Enable Space"
        : "Space unavailable; audio is bypassed.");
      spaceFxBypassBtn.textContent = spaceEffectAvailable
        ? effectiveEnabled ? "Bypass Space" : "Enable Space"
        : "Space unavailable; audio is bypassed.";
    }
    spaceFxPresetCards.forEach(function (card) {
      const selected = card.dataset.spacePreset === state.preset;
      card.disabled = controlsDisabled;
      card.dataset.spaceSelected = selected ? "true" : "false";
      card.setAttribute("aria-pressed", selected ? "true" : "false");
    });
    spaceFxMacroInputs.forEach(function (input) {
      const control = input.dataset.spaceMacro;
      if (!control || !(control in state)) return;
      input.disabled = controlsDisabled;
      input.value = state[control].toString();
      input.setAttribute("aria-valuetext", formatSpaceMacroValue(control, state[control], true));
    });
    spaceFxMacroOutputs.forEach(function (output) {
      const control = output.dataset.spaceOutput;
      if (control && control in state) output.textContent = formatSpaceMacroValue(control, state[control]);
    });
    renderFilterEffectUi();
  }

  function setFilterEffectState(nextState, options) {
    const normalized = normalizeFilterEffectState(nextState);
    filterEffectState = normalized;
    if (masterEffectsChain && filterEffectAvailable) {
      try {
        masterEffectsChain.applyToneState(normalized, {
          immediate: Boolean(options && options.immediate),
        });
      } catch (error) {
        disableFilterEffectGraph(error);
      }
    }
    renderFilterEffectUi();
    return { ...filterEffectState };
  }

  function applyFilterEffectPreset(presetId) {
    const presetState = getFilterEffectPresetState(presetId);
    if (!presetState) return false;
    setFilterEffectState(presetState);
    return true;
  }

  function announceFilterAction(message) {
    if (!filterFxActionStatus) return;
    filterFxActionStatus.textContent = "";
    void Promise.resolve().then(function () {
      filterFxActionStatus.textContent = message;
    });
  }

  function resetFilterEffectState() {
    setFilterEffectState(createDefaultFilterEffectState());
    announceFilterAction("Filter reset; bypassed.");
  }

  function prefersReducedFilterMotion() {
    return Boolean(
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches
    );
  }

  function clearFilterPanelTransitionCompletion() {
    if (filterPanelHideTimerId !== null) {
      window.clearTimeout(filterPanelHideTimerId);
      filterPanelHideTimerId = null;
    }
    if (filterFxBody && filterPanelTransitionEndHandler) {
      filterFxBody.removeEventListener("transitionend", filterPanelTransitionEndHandler);
      filterPanelTransitionEndHandler = null;
    }
  }

  function finishFilterPanelCollapse(generation) {
    if (
      !filterFxBody ||
      generation !== filterPanelTransitionGeneration ||
      filterPanelExpanded
    ) {
      return;
    }
    clearFilterPanelTransitionCompletion();
    filterFxBody.hidden = true;
    filterFxBody.dataset.transitioning = "false";
  }

  function setFilterPanelExpanded(expanded, options) {
    const nextExpanded = Boolean(expanded);
    if (!filterFxBody || !filterFxToggle) return false;
    const shouldAnimate =
      !(options && options.animate === false) && !prefersReducedFilterMotion();
    const generation = ++filterPanelTransitionGeneration;

    clearFilterPanelTransitionCompletion();

    if (
      !nextExpanded &&
      document.activeElement instanceof Element &&
      filterFxBody.contains(document.activeElement)
    ) {
      filterFxToggle.focus();
    }

    filterPanelExpanded = nextExpanded;
    filterFxBody.dataset.transitioning = shouldAnimate ? "true" : "false";
    filterFxToggle.setAttribute("aria-expanded", nextExpanded ? "true" : "false");
    filterFxToggle.setAttribute(
      "aria-label",
      nextExpanded ? "Hide effects" : "Show effects"
    );
    if (filterFxToggleLabel) {
      filterFxToggleLabel.textContent = nextExpanded ? "Hide effects" : "Show effects";
    }

    if (nextExpanded) {
      filterFxBody.hidden = false;
      filterFxBody.inert = false;
      filterFxBody.removeAttribute("inert");
      filterFxBody.removeAttribute("aria-hidden");
      filterFxBody.dataset.expanded = "false";
      if (shouldAnimate) {
        void filterFxBody.offsetHeight;
      }
      filterFxBody.dataset.expanded = "true";
      if (!shouldAnimate) filterFxBody.dataset.transitioning = "false";
      return true;
    }

    filterFxBody.dataset.expanded = "false";
    filterFxBody.inert = true;
    filterFxBody.setAttribute("inert", "");
    filterFxBody.setAttribute("aria-hidden", "true");
    if (!shouldAnimate) {
      finishFilterPanelCollapse(generation);
      return true;
    }

    filterPanelTransitionEndHandler = function (event) {
      if (
        event.target !== filterFxBody ||
        (event.propertyName && event.propertyName !== "grid-template-rows")
      ) {
        return;
      }
      finishFilterPanelCollapse(generation);
    };
    filterFxBody.addEventListener("transitionend", filterPanelTransitionEndHandler);
    filterPanelHideTimerId = window.setTimeout(function () {
      finishFilterPanelCollapse(generation);
    }, FILTER_PANEL_TRANSITION_MS);
    return true;
  }

  function bindFilterEffectControls() {
    if (filterControlsBound) return;
    filterControlsBound = true;

    if (filterFxToggle) {
      filterFxToggle.addEventListener("click", function () {
        setFilterPanelExpanded(!filterPanelExpanded);
      });
    }
    if (filterFxBypassBtn) {
      filterFxBypassBtn.addEventListener("click", function () {
        setFilterEffectState({ ...filterEffectState, enabled: !filterEffectState.enabled });
      });
    }
    if (filterFxPreset) {
      filterFxPreset.addEventListener("change", function () {
        applyFilterEffectPreset(filterFxPreset.value);
      });
    }
    filterFxPresetCards.forEach(function (card) {
      card.addEventListener("click", function () {
        const presetId = card.dataset.filterPresetCard;
        if (!presetId) return;
        if (presetId === "custom") {
          setFilterEffectState({ ...filterEffectState, preset: "custom" });
        } else {
          applyFilterEffectPreset(presetId);
        }
        announceFilterAction(getFilterPresetDisplayName(presetId) + " Filter selected.");
      });
    });
    if (filterFxResetBtn) {
      filterFxResetBtn.addEventListener("click", function () {
        resetFilterEffectState();
      });
    }
    if (spaceFxBypassBtn) {
      spaceFxBypassBtn.addEventListener("click", function () {
        spaceController.setEnabled(!spaceEffectState.enabled);
      });
    }
    spaceFxPresetCards.forEach(function (card) {
      card.addEventListener("click", function () {
        const presetId = card.dataset.spacePreset;
        if (!presetId) return;
        if (presetId === "custom") {
          spaceController.setState({ ...spaceEffectState, preset: "custom" });
        } else {
          spaceController.selectPreset(presetId);
        }
      });
    });
    spaceFxMacroInputs.forEach(function (input) {
      input.addEventListener("input", function () {
        const control = input.dataset.spaceMacro;
        if (!control) return;
        spaceController.setMacro(control, Number(input.value));
      });
    });

    filterFxMacroInputs.forEach(function (input) {
      function commitInputValue() {
        const control = input.dataset.filterMacro;
        if (!control) return;
        setFilterEffectState({
          ...filterEffectState,
          [control]: Number(input.value),
          preset: "custom",
        });
      }

      input.addEventListener("input", commitInputValue);
      input.addEventListener("keydown", function (event) {
        if (event.key !== "PageUp" && event.key !== "PageDown") return;
        event.preventDefault();
        const direction = event.key === "PageUp" ? 1 : -1;
        const nextValue = Math.min(100, Math.max(0, Number(input.value) + direction * 10));
        input.value = nextValue.toString();
        commitInputValue();
      });
    });

    setFilterPanelExpanded(false, { animate: false });
    renderFilterEffectUi();
    renderSpaceEffectUi();
  }

  function disableFilterEffectGraph(error) {
    if (error) {
      console.warn("Filter effect is unavailable; using neutral master audio:", error);
    }
    if (masterEffectsChain) masterEffectsChain.makeToneUnavailable();
    masterFilterGraph = null;
    filterEffectAvailable = false;
    renderFilterEffectUi();
  }

  function trackFilterTransportClose(graph, closeOperation) {
    const trackedClose = Promise.resolve(closeOperation).catch(function () {
      return false;
    });
    filterTransportClosePromise = trackedClose;
    void trackedClose.then(function (closed) {
      if (masterEffectsChain === graph) refreshEffectsAvailability();
      if (
        !closed &&
        filterTransportClosePromise === trackedClose &&
        masterEffectsChain === graph &&
        audioCtx &&
        audioCtx.state !== "closed"
      ) {
        audioInitializationError = new Error("The terminal effects gate could not close safely.");
      }
    });
    return trackedClose;
  }

  function initializeMasterOutput() {
    if (masterEffectsChain) {
      refreshEffectsAvailability();
      renderFilterEffectUi();
      return;
    }
    if (blockedMasterEffectsChain) {
      try {
        blockedMasterEffectsChain.disconnect();
        blockedMasterEffectsChain = null;
      } catch (_cleanupError) {
        filterEffectAvailable = false;
        spaceEffectAvailable = false;
        renderFilterEffectUi();
        return;
      }
    }
    if (!audioCtx) {
      filterEffectAvailable = false;
      spaceEffectAvailable = false;
      renderFilterEffectUi();
      return;
    }

    try {
      masterGainNode = audioCtx.createGain();
      masterGainNode.gain.value = 0.25;

      if (typeof audioCtx.createDynamicsCompressor === "function") {
        masterProtectionNode = audioCtx.createDynamicsCompressor();
        masterProtectionNode.threshold.value = -6;
        masterProtectionNode.knee.value = 3;
        masterProtectionNode.ratio.value = 12;
        masterProtectionNode.attack.value = 0.003;
        masterProtectionNode.release.value = 0.25;
        masterProtectionNode.connect(audioCtx.destination);
        masterOutputDestination = masterProtectionNode;
      } else {
        masterOutputDestination = audioCtx.destination;
      }

      try {
        masterEffectsChain = createMasterEffectsChain(
          audioCtx,
          masterOutputDestination,
          { toneState: filterEffectState, spaceState: spaceEffectState },
          {
            isLifecycleValid() {
              return document.visibilityState !== "hidden" && masterEffectsChain !== null;
            },
          }
        );
        refreshEffectsAvailability();
        masterGainNode.connect(masterEffectsChain.input);
        filterEffectAvailable = Boolean(masterFilterGraph);
      } catch (filterError) {
        try {
          masterGainNode.disconnect();
        } catch (_disconnectError) {
          // A failed final connection may not have attached the master input.
        }
        if (masterEffectsChain) {
          try {
            masterEffectsChain.disconnect();
          } catch (_disconnectError) {
            // The failed graph connection may already be torn down.
          }
        }
        masterFilterGraph = null; masterEffectsChain = null;
        filterEffectAvailable = false; spaceEffectAvailable = false;
        throw filterError;
      }
    } catch (error) {
      if (masterEffectsChain) {
        try {
          masterEffectsChain.disconnect();
        } catch (_disconnectError) {
          // The graph may have failed during its own cleanup.
        }
      }
      if (masterGainNode) {
        try {
          masterGainNode.disconnect();
        } catch (_disconnectError) {
          // The master input may only be partially connected.
        }
      }
      if (masterProtectionNode) {
        try {
          masterProtectionNode.disconnect();
        } catch (_disconnectError) {
          // The protection node may not have reached the destination.
        }
      }
      audioInitializationError = error;
      masterGainNode = null;
      masterProtectionNode = null;
      masterOutputDestination = null;
      masterFilterGraph = null;
      masterEffectsChain = null;
      filterEffectAvailable = false;
      spaceEffectAvailable = false;
    }
    renderFilterEffectUi();
  }

  function setAudioStatus(message, state) {
    if (!audioStatus) return;
    audioStatus.textContent = message;
    audioStatus.dataset.state = state || "ready";
  }

  function getSampleLoadSummary() {
    const summary = {
      ready: [],
      loading: [],
      failed: [],
      idle: [],
    };

    instrumentsOrder.forEach(function (instrument) {
      const state = sampleLoadStates[instrument] || "idle";
      summary[state].push(instrument);
    });

    return summary;
  }

  function updateInstrumentSampleState(instrument, state) {
    const container = getInstrumentContainer(instrument);
    const row = container ? container.closest(".sequence-row") : null;
    if (!row) return;

    row.dataset.sampleState = state;
    if (state === "failed") {
      row.title = formatInstrumentName(instrument) + " sound is unavailable";
    } else {
      row.removeAttribute("title");
    }
  }

  function updateAudioReadinessUi() {
    if (audioCtx && audioCtx.state === "closed") {
      setAudioStatus("Audio is no longer available. Reload the page to restore playback.", "error");
      playBtn.disabled = true;
      if (retrySamplesBtn) retrySamplesBtn.hidden = true;
      return;
    }

    if (!audioCtx || !masterGainNode) {
      const message =
        audioInitializationError instanceof Error
          ? audioInitializationError.message
          : "Audio could not be initialized in this browser.";
      setAudioStatus(message, "error");
      playBtn.disabled = true;
      if (retrySamplesBtn) retrySamplesBtn.hidden = true;
      return;
    }

    const summary = getSampleLoadSummary();
    const total = instrumentsOrder.length;
    const failedNames = summary.failed.map(formatInstrumentName).join(", ");

    if (playbackAudioError) {
      setAudioStatus(playbackAudioError, "error");
    } else if (summary.loading.length) {
      setAudioStatus(
        "Loading sounds: " + summary.ready.length + " of " + total + " ready…",
        summary.failed.length ? "warning" : "loading"
      );
    } else if (summary.failed.length && summary.ready.length) {
      setAudioStatus(
        summary.ready.length +
          " of " +
          total +
          " sounds ready. Unavailable: " +
          failedNames +
          ".",
        "warning"
      );
    } else if (summary.failed.length) {
      setAudioStatus(
        "No sounds loaded. Unavailable: " + failedNames + ". Retry to restore playback.",
        "error"
      );
    } else if (summary.ready.length === total) {
      setAudioStatus(total + " sounds ready.", "ready");
    } else {
      setAudioStatus("Preparing sounds…", "loading");
    }

    playBtn.disabled = isStartingPlayback || summary.ready.length === 0;
    if (retrySamplesBtn) {
      retrySamplesBtn.hidden = summary.failed.length === 0 && !isRetryingSamples;
      retrySamplesBtn.disabled = isRetryingSamples;
      retrySamplesBtn.textContent = isRetryingSamples
        ? "Retrying sounds…"
        : "Retry failed sounds";
    }
  }

  function getValidatedBpm(value) {
    const bpm = normalizeBpm(value, DEFAULT_BPM);
    if (bpmInput.value !== bpm.toString()) {
      bpmInput.value = bpm.toString();
    }
    return bpm;
  }

  function setStepActiveState(step, active) {
    step.classList.toggle("active", Boolean(active));
    step.setAttribute("aria-pressed", active ? "true" : "false");
  }

  function toggleStep(step) {
    setStepActiveState(step, !step.classList.contains("active"));
    saveSelectedPatternFromGrid();
    renderPitchRollGrid();
  }

  initializeMasterOutput();
  if (audioCtx && typeof audioCtx.addEventListener === "function") {
    audioCtx.addEventListener("statechange", function () {
      if (audioCtx.state === "running") return;

      if (audioCtx.state === "closed") {
        playbackAudioError = "Audio closed unexpectedly. Reload the page to restore playback.";
      } else if (isPlaying || isStartingPlayback) {
        playbackAudioError = "Audio was interrupted. Press Play to restart it.";
      }

      if (isPlaying || isStartingPlayback) {
        stopSequencer();
      } else {
        cancelScheduledSources({ forceImmediate: true });
        clearScheduledHighlightTimers();
        clearPlayingHighlight();
        if (masterEffectsChain) {
          const graph = masterEffectsChain;
          try {
            trackFilterTransportClose(
              graph,
              graph.silence({ immediate: true })
            );
          } catch (filterError) {
            disableFilterEffectGraph(filterError);
          }
        }
        updateAudioReadinessUi();
      }
    });
  }
  bpmInput.addEventListener("change", function () {
    getValidatedBpm(bpmInput.value);
    renderInstrumentScreen();
  });
  bpmInput.addEventListener("input", function () {
    renderInstrumentScreen();
  });

  function closeMobileHelpTooltip() {
    if (!mobileHelpWrap || !mobileHelpBtn) {
      return;
    }
    mobileHelpWrap.classList.remove("is-open");
    mobileHelpBtn.setAttribute("aria-expanded", "false");
  }

  function bindMobileHelpTooltip() {
    if (!mobileHelpWrap || !mobileHelpBtn) {
      return;
    }

    mobileHelpBtn.addEventListener("click", function (event) {
      event.stopPropagation();
      const isOpen = mobileHelpWrap.classList.contains("is-open");
      closeMobileHelpTooltip();
      if (!isOpen) {
        mobileHelpWrap.classList.add("is-open");
        mobileHelpBtn.setAttribute("aria-expanded", "true");
      }
    });

    document.addEventListener("click", function (event) {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }
      if (target.closest(".mobile-help-wrap")) {
        return;
      }
      closeMobileHelpTooltip();
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") {
        closeMobileHelpTooltip();
      }
    });
  }

  function closePitchRoll() {
    if (!pitchRollDialog || pitchRollDialog.hidden) {
      return;
    }

    const focusTarget = pitchRollReturnFocusElement;
    if (focusTarget instanceof HTMLElement) {
      focusTarget.setAttribute("aria-expanded", "false");
    }
    pitchRollDialog.hidden = true;
    activePitchInstrument = null;
    pitchRollReturnFocusElement = null;

    if (focusTarget instanceof HTMLElement && focusTarget.isConnected) {
      window.requestAnimationFrame(function () {
        focusTarget.focus();
      });
    }
  }

  function setInstrumentStepActiveInGrid(instrument, stepIndex, active) {
    const container = getInstrumentContainer(instrument);
    if (!container) return;
    const stepDiv = container.querySelector("[data-step='" + stepIndex + "']");
    if (!stepDiv) return;
    setStepActiveState(stepDiv, active);
  }

  function applyPitchCellSelection(stepIndex, pitchOffset) {
    if (!activePitchInstrument) return;
    ensureSongState();

    const instrumentIndex = instrumentsOrder.indexOf(activePitchInstrument);
    if (instrumentIndex === -1) return;

    const currentPattern = patterns[selectedPatternIndex];
    const isCurrentlyActive = isStepActive(currentPattern, instrumentIndex, stepIndex);
    const currentPitchOffset = getStepPitchOffset(
      selectedPatternIndex,
      activePitchInstrument,
      stepIndex
    );

    if (isCurrentlyActive && currentPitchOffset === pitchOffset) {
      setInstrumentStepActiveInGrid(activePitchInstrument, stepIndex, false);
      setStepPitchOffset(selectedPatternIndex, activePitchInstrument, stepIndex, 0);
    } else {
      setInstrumentStepActiveInGrid(activePitchInstrument, stepIndex, true);
      setStepPitchOffset(selectedPatternIndex, activePitchInstrument, stepIndex, pitchOffset);
    }

    saveSelectedPatternFromGrid();
    renderPitchRollGrid();
  }

  function renderPitchRollGrid() {
    if (!pitchRollGrid || !pitchRollTitle || !activePitchInstrument) {
      return;
    }

    ensureSongState();
    const instrumentIndex = instrumentsOrder.indexOf(activePitchInstrument);
    const currentPattern = patterns[selectedPatternIndex];
    const focusedCell =
      document.activeElement instanceof HTMLElement &&
      pitchRollGrid.contains(document.activeElement)
        ? document.activeElement
        : null;
    const focusedStep = focusedCell ? focusedCell.dataset.pitchStep : null;
    const focusedPitch = focusedCell ? focusedCell.dataset.pitchOffset : null;
    pitchRollTitle.textContent = formatInstrumentName(activePitchInstrument) + " Pitch Roll";

    pitchRollGrid.innerHTML = "";
    PITCH_LEVELS.forEach(function (pitchOffset) {
      const row = document.createElement("div");
      row.className = "pitch-roll-row";

      const label = document.createElement("span");
      label.className = "pitch-roll-row-label";
      label.textContent = formatPitchOffsetLabel(pitchOffset);
      row.appendChild(label);

      for (let stepIndex = 0; stepIndex < STEPS_PER_PATTERN; stepIndex++) {
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "pitch-roll-cell";
        cell.dataset.pitchStep = stepIndex.toString();
        cell.dataset.pitchOffset = pitchOffset.toString();
        const isQuarter = stepIndex % 4 === 0;
        if (isQuarter) {
          cell.classList.add("is-quarter");
        }

        const isActive = isStepActive(currentPattern, instrumentIndex, stepIndex);
        const stepPitchOffset = getStepPitchOffset(
          selectedPatternIndex,
          activePitchInstrument,
          stepIndex
        );
        if (!isActive) {
          cell.classList.add("is-muted");
        }
        if (isActive && stepPitchOffset === pitchOffset) {
          cell.classList.add("is-active");
        }
        cell.setAttribute(
          "aria-pressed",
          isActive && stepPitchOffset === pitchOffset ? "true" : "false"
        );

        cell.setAttribute(
          "aria-label",
          formatInstrumentName(activePitchInstrument) +
            " step " +
            (stepIndex + 1).toString() +
            " pitch " +
            formatPitchOffsetLabel(pitchOffset)
        );
        cell.addEventListener("click", function () {
          applyPitchCellSelection(stepIndex, pitchOffset);
        });
        row.appendChild(cell);
      }

      pitchRollGrid.appendChild(row);
    });

    if (focusedStep !== null && focusedPitch !== null) {
      const nextFocusedCell = pitchRollGrid.querySelector(
        "[data-pitch-step='" +
          focusedStep +
          "'][data-pitch-offset='" +
          focusedPitch +
          "']"
      );
      if (nextFocusedCell instanceof HTMLElement) {
        nextFocusedCell.focus();
      }
    }
  }

  function openPitchRoll(instrument, trigger) {
    if (!pitchRollDialog) return;
    closeAllInstrumentVolumePanels();
    document.querySelectorAll("[data-pitch-trigger]").forEach(function (pitchTrigger) {
      pitchTrigger.setAttribute("aria-expanded", "false");
    });
    activePitchInstrument = instrument;
    pitchRollReturnFocusElement = trigger instanceof HTMLElement ? trigger : null;
    if (pitchRollReturnFocusElement) {
      pitchRollReturnFocusElement.setAttribute("aria-expanded", "true");
    }
    pitchRollDialog.hidden = false;
    renderPitchRollGrid();
    window.requestAnimationFrame(function () {
      if (pitchRollCloseBtn) pitchRollCloseBtn.focus();
    });
  }

  function getPitchRollFocusableElements() {
    if (!pitchRollDialog) return [];
    return Array.from(
      pitchRollDialog.querySelectorAll(
        "button:not([disabled]), input:not([disabled]), [href], [tabindex]:not([tabindex='-1'])"
      )
    ).filter(function (element) {
      return element instanceof HTMLElement && !element.hidden;
    });
  }

  function bindPitchRollControls() {
    if (pitchRollBound) {
      return;
    }

    document.querySelectorAll("[data-pitch-trigger]").forEach(function (trigger) {
      trigger.setAttribute("aria-haspopup", "dialog");
      trigger.setAttribute("aria-controls", "pitchRollDialog");
      trigger.setAttribute("aria-expanded", "false");
      trigger.addEventListener("click", function () {
        const instrument = trigger.getAttribute("data-pitch-trigger");
        if (!instrument) return;
        if (!pitchRollDialog) return;
        if (!pitchRollDialog.hidden && activePitchInstrument === instrument) {
          closePitchRoll();
          return;
        }
        openPitchRoll(instrument, trigger);
      });
    });

    if (pitchRollCloseBtn) {
      pitchRollCloseBtn.addEventListener("click", function () {
        closePitchRoll();
      });
    }

    if (pitchRollResetBtn) {
      pitchRollResetBtn.addEventListener("click", function () {
        if (!activePitchInstrument) return;
        ensureSongState();
        patternPitchOffsets[selectedPatternIndex][activePitchInstrument] =
          createDefaultInstrumentPitchOffsets();
        renderPitchRollGrid();
      });
    }

    if (pitchRollDialog) {
      pitchRollDialog.addEventListener("click", function (event) {
        if (event.target === pitchRollDialog) {
          closePitchRoll();
        }
      });

      pitchRollDialog.addEventListener("keydown", function (event) {
        if (pitchRollDialog.hidden) return;

        if (event.key === "Escape") {
          event.preventDefault();
          closePitchRoll();
          return;
        }

        if (event.key !== "Tab") return;
        const focusableElements = getPitchRollFocusableElements();
        if (!focusableElements.length) {
          event.preventDefault();
          return;
        }

        const first = focusableElements[0];
        const last = focusableElements[focusableElements.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    }

    pitchRollBound = true;
  }

  window.addEventListener("load", async function () {
    shareBtn.disabled = false;
    loopPatternBtn.disabled = false;
    clearProjectBtn.disabled = false;
    updateLoopPatternButtonState();

    document.querySelectorAll(".step").forEach(function (step) {
      const instrumentContainer = step.closest("[data-instrument]");
      const instrument = instrumentContainer
        ? instrumentContainer.getAttribute("data-instrument")
        : "instrument";
      const stepIndex = Number(step.getAttribute("data-step")) + 1;

      step.setAttribute("role", "button");
      step.tabIndex = 0;
      step.setAttribute(
        "aria-label",
        formatInstrumentName(instrument || "instrument") + " step " + stepIndex.toString()
      );
      setStepActiveState(step, step.classList.contains("active"));

      step.addEventListener("click", function () {
        toggleStep(step);
      });

      step.addEventListener("keydown", function (event) {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        if (event.repeat) return;
        toggleStep(step);
      });
    });

    bindMobileHelpTooltip();
    bindPitchRollControls();
    bindInstrumentVolumeControls();
    bindFilterEffectControls();
    if (retrySamplesBtn) {
      retrySamplesBtn.addEventListener("click", function () {
        void retryFailedSamples();
      });
    }
    loadFromURLParams();
    ensureSongState();
    loadSelectedPatternIntoGrid();
    updatePatternMeta();
    tryWireArrangementControlsWithRetry(30, 100);
    window.renderPatternManager = function () {
      updatePatternMeta();
      return tryWireArrangementControlsWithRetry(30, 100);
    };
    window.addEventListener("arrangement:ready", function () {
      window.renderPatternManager();
    });

    updateAudioReadinessUi();
    await loadSamples(instrumentsOrder);
  });

  /************************************************
   * Visibility => stop sequencer if hidden
   ************************************************/
  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "hidden" && (isPlaying || isStartingPlayback)) {
      stopSequencer();
    }
  });

  function createEmptyPatternBytes() {
    return new Uint8Array(BYTES_PER_PATTERN);
  }

  function createDefaultInstrumentVolumes() {
    const defaults = {};
    instrumentsOrder.forEach(function (instrument) {
      defaults[instrument] = DEFAULT_INSTRUMENT_VOLUME_PERCENT;
    });
    return defaults;
  }

  function createDefaultInstrumentPitchOffsets() {
    return Array(STEPS_PER_PATTERN).fill(0);
  }

  function createDefaultPatternPitchOffsets() {
    const defaults = {};
    instrumentsOrder.forEach(function (instrument) {
      defaults[instrument] = createDefaultInstrumentPitchOffsets();
    });
    return defaults;
  }

  function formatInstrumentName(instrument) {
    return instrument
      .split("_")
      .map(function (part) {
        return part.charAt(0).toUpperCase() + part.slice(1);
      })
      .join("-");
  }

  function formatPitchOffsetLabel(offset) {
    if (offset === 0) return "0";
    return (offset > 0 ? "+" : "") + offset.toString();
  }

  function clampInt(value, min, max, fallback) {
    const parsed = parseInt(value, 10);
    if (isNaN(parsed)) return fallback;
    if (parsed < min) return min;
    if (parsed > max) return max;
    return parsed;
  }

  function clampVolumePercent(value, fallback) {
    const parsed = parseFloat(value);
    if (!Number.isFinite(parsed)) {
      return fallback;
    }
    const clamped = Math.min(100, Math.max(0, parsed));
    return Math.round(clamped / INSTRUMENT_VOLUME_STEP_PERCENT) * INSTRUMENT_VOLUME_STEP_PERCENT;
  }

  function clampPitchOffset(value) {
    return clampInt(value, PITCH_MIN_SEMITONES, PITCH_MAX_SEMITONES, 0);
  }

  function normalizeInstrumentPitchOffsets(rawOffsets) {
    const normalized = createDefaultInstrumentPitchOffsets();
    if (!Array.isArray(rawOffsets)) {
      return normalized;
    }

    for (let stepIndex = 0; stepIndex < STEPS_PER_PATTERN; stepIndex++) {
      normalized[stepIndex] = clampPitchOffset(rawOffsets[stepIndex]);
    }
    return normalized;
  }

  function normalizePatternPitchOffsets(rawPatternPitch) {
    const normalized = createDefaultPatternPitchOffsets();
    if (!rawPatternPitch || typeof rawPatternPitch !== "object") {
      return normalized;
    }

    instrumentsOrder.forEach(function (instrument) {
      normalized[instrument] = normalizeInstrumentPitchOffsets(rawPatternPitch[instrument]);
    });

    return normalized;
  }

  function getStepPitchOffset(patternIndex, instrument, stepIndex) {
    const patternPitch = patternPitchOffsets[patternIndex];
    if (!patternPitch || !Array.isArray(patternPitch[instrument])) {
      return 0;
    }
    return clampPitchOffset(patternPitch[instrument][stepIndex]);
  }

  function setStepPitchOffset(patternIndex, instrument, stepIndex, pitchOffset) {
    if (!patternPitchOffsets[patternIndex]) {
      patternPitchOffsets[patternIndex] = createDefaultPatternPitchOffsets();
    }
    if (!Array.isArray(patternPitchOffsets[patternIndex][instrument])) {
      patternPitchOffsets[patternIndex][instrument] = createDefaultInstrumentPitchOffsets();
    }
    patternPitchOffsets[patternIndex][instrument][stepIndex] = clampPitchOffset(pitchOffset);
  }

  function serializePatternPitchOffsets(patternPitch) {
    const encoded = {};
    if (!patternPitch || typeof patternPitch !== "object") {
      return encoded;
    }

    instrumentsOrder.forEach(function (instrument) {
      const offsets = normalizeInstrumentPitchOffsets(patternPitch[instrument]);
      const entries = [];
      offsets.forEach(function (pitchOffset, stepIndex) {
        if (pitchOffset === 0) return;
        entries.push(stepIndex.toString() + ":" + pitchOffset.toString());
      });
      if (entries.length) {
        encoded[instrument] = entries.join(",");
      }
    });

    return encoded;
  }

  function deserializePatternPitchOffsets(rawPatternPitch) {
    const normalized = createDefaultPatternPitchOffsets();
    if (!rawPatternPitch || typeof rawPatternPitch !== "object") {
      return normalized;
    }

    instrumentsOrder.forEach(function (instrument) {
      const encoded = rawPatternPitch[instrument];
      if (typeof encoded !== "string" || !encoded.trim()) {
        return;
      }

      encoded.split(",").forEach(function (entry) {
        const parts = entry.split(":");
        if (parts.length < 2) return;
        const stepIndex = parseInt(parts[0], 10);
        const pitchOffset = parseInt(parts[1], 10);
        if (isNaN(stepIndex) || stepIndex < 0 || stepIndex >= STEPS_PER_PATTERN) {
          return;
        }
        normalized[instrument][stepIndex] = clampPitchOffset(pitchOffset);
      });
    });

    return normalized;
  }

  function normalizeInstrumentVolumes(rawVolumes) {
    const normalized = createDefaultInstrumentVolumes();

    if (Array.isArray(rawVolumes)) {
      instrumentsOrder.forEach(function (instrument, index) {
        normalized[instrument] = clampVolumePercent(
          rawVolumes[index],
          DEFAULT_INSTRUMENT_VOLUME_PERCENT
        );
      });
      return normalized;
    }

    if (rawVolumes && typeof rawVolumes === "object") {
      instrumentsOrder.forEach(function (instrument) {
        normalized[instrument] = clampVolumePercent(
          rawVolumes[instrument],
          DEFAULT_INSTRUMENT_VOLUME_PERCENT
        );
      });
      return normalized;
    }

    return normalized;
  }

  function getInstrumentVolumePercent(instrument) {
    const current = instrumentVolumes[instrument];
    return clampVolumePercent(current, DEFAULT_INSTRUMENT_VOLUME_PERCENT);
  }

  function closeAllInstrumentVolumePanels() {
    instrumentsOrder.forEach(function (instrument) {
      const wrap = instrumentVolumeWraps[instrument];
      const trigger = instrumentVolumeTriggers[instrument];
      if (wrap) {
        wrap.classList.remove("is-open");
      }
      if (trigger) {
        trigger.setAttribute("aria-expanded", "false");
      }
    });
  }

  function openInstrumentVolumePanel(instrument) {
    const wrap = instrumentVolumeWraps[instrument];
    const trigger = instrumentVolumeTriggers[instrument];
    if (!wrap || !trigger) {
      return;
    }

    wrap.classList.add("is-open");
    trigger.setAttribute("aria-expanded", "true");
  }

  function bindInstrumentVolumePanelDismiss() {
    if (instrumentVolumeDismissBound) {
      return;
    }

    document.addEventListener("click", function (event) {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }
      if (target.closest(".instrument-volume-tooltip-wrap")) {
        return;
      }
      closeAllInstrumentVolumePanels();
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") {
        closeAllInstrumentVolumePanels();
      }
    });

    instrumentVolumeDismissBound = true;
  }

  function bindInstrumentVolumeControls() {
    instrumentsOrder.forEach(function (instrument) {
      const input = document.querySelector(
        "[data-volume-input='" + instrument + "']"
      );
      const valueLabel = document.querySelector(
        "[data-volume-value='" + instrument + "']"
      );
      const trigger = document.querySelector(
        "[data-volume-trigger='" + instrument + "']"
      );
      const wrap = document.querySelector(
        "[data-volume-wrap='" + instrument + "']"
      );
      if (!input || !valueLabel || !trigger || !wrap) return;

      instrumentVolumeInputs[instrument] = input;
      instrumentVolumeValues[instrument] = valueLabel;
      instrumentVolumeTriggers[instrument] = trigger;
      instrumentVolumeWraps[instrument] = wrap;

      input.addEventListener("input", function () {
        setInstrumentVolumePercent(instrument, input.value);
      });

      trigger.addEventListener("click", function () {
        const isOpen = wrap.classList.contains("is-open");
        closeAllInstrumentVolumePanels();
        if (!isOpen) {
          openInstrumentVolumePanel(instrument);
        }
      });
    });

    bindInstrumentVolumePanelDismiss();
    syncAllInstrumentVolumeControls();
  }

  function syncInstrumentVolumeControl(instrument) {
    const input = instrumentVolumeInputs[instrument];
    const valueLabel = instrumentVolumeValues[instrument];
    const volumePercent = getInstrumentVolumePercent(instrument);

    if (input) {
      input.value = volumePercent.toString();
    }
    if (valueLabel) {
      valueLabel.textContent = volumePercent.toString() + "%";
    }
  }

  function syncAllInstrumentVolumeControls() {
    instrumentsOrder.forEach(function (instrument) {
      syncInstrumentVolumeControl(instrument);
    });
  }

  function setAllInstrumentVolumes(nextVolumes) {
    instrumentVolumes = normalizeInstrumentVolumes(nextVolumes);
    syncAllInstrumentVolumeControls();
  }

  function setInstrumentVolumePercent(instrument, volumePercent) {
    if (!instrumentsOrder.includes(instrument)) {
      return;
    }

    instrumentVolumes[instrument] = clampVolumePercent(
      volumePercent,
      getInstrumentVolumePercent(instrument)
    );
    syncInstrumentVolumeControl(instrument);
  }

  function getInstrumentVolumeGain(instrument) {
    return getInstrumentVolumePercent(instrument) / 100;
  }

  function encodeMixParam() {
    return instrumentsOrder
      .map(function (instrument) {
        return getInstrumentVolumePercent(instrument);
      })
      .join(".");
  }

  function loadMixParam(mixParam) {
    if (typeof mixParam !== "string") {
      return false;
    }

    const parts = mixParam
      .split(".")
      .map(function (value) {
        return parseInt(value, 10);
      })
      .filter(function (value) {
        return Number.isFinite(value);
      });

    if (!parts.length) {
      return false;
    }

    setAllInstrumentVolumes(parts);
    return true;
  }

  function bindArrangementElements() {
    patternList = document.getElementById("patternList");
    newPatternBtn = document.getElementById("newPatternBtn");
    clearPatternBtn = document.getElementById("clearPatternBtn");

    return Boolean(
      patternList &&
        newPatternBtn &&
        clearPatternBtn
    );
  }

  function areArrangementElementsConnected() {
    return Boolean(
      patternList &&
        patternList.isConnected &&
        newPatternBtn &&
        newPatternBtn.isConnected &&
        clearPatternBtn &&
        clearPatternBtn.isConnected
    );
  }

  function tryWireArrangementControlsWithRetry(maxRetries, intervalMs) {
    if (wireArrangementControls()) {
      renderPatternList();
      updatePatternMeta();
      return true;
    }

    let retries = 0;
    const retryTimer = setInterval(function () {
      retries += 1;
      if (wireArrangementControls()) {
        clearInterval(retryTimer);
        renderPatternList();
        updatePatternMeta();
      } else if (retries >= maxRetries) {
        clearInterval(retryTimer);
      }
    }, intervalMs);

    return false;
  }

  /************************************************
   * Load samples independently so one failure does not block playback
   ************************************************/
  function loadSample(instrument, options) {
    if (!audioCtx || !sampleURLs[instrument]) {
      updateAudioReadinessUi();
      return Promise.resolve(false);
    }

    if (sampleLoadPromises[instrument]) {
      return sampleLoadPromises[instrument];
    }

    const reload = Boolean(options && options.reload);
    if (!reload && sampleLoadStates[instrument] === "ready") {
      return Promise.resolve(true);
    }

    sampleLoadStates[instrument] = "loading";
    updateInstrumentSampleState(instrument, "loading");
    updateAudioReadinessUi();

    const abortController =
      typeof AbortController === "function" ? new AbortController() : null;
    const abortTimeoutId = abortController
      ? window.setTimeout(function () {
          abortController.abort();
        }, SAMPLE_FETCH_TIMEOUT_MS)
      : null;

    const loadPromise = (async function () {
      try {
        const response = await fetch(sampleURLs[instrument], {
          cache: reload ? "reload" : "default",
          signal: abortController ? abortController.signal : undefined,
        });
        if (!response.ok) {
          throw new Error(
            "Failed to fetch " + sampleURLs[instrument] + ": " + response.status
          );
        }

        const audioData = await response.arrayBuffer();
        audioBuffers[instrument] = await audioCtx.decodeAudioData(audioData);
        sampleLoadStates[instrument] = "ready";
        return true;
      } catch (error) {
        delete audioBuffers[instrument];
        sampleLoadStates[instrument] = "failed";
        console.error("Error loading sample for " + instrument + ":", error);
        return false;
      } finally {
        if (abortTimeoutId !== null) {
          window.clearTimeout(abortTimeoutId);
        }
      }
    })();

    sampleLoadPromises[instrument] = loadPromise;
    void loadPromise.finally(function () {
      if (sampleLoadPromises[instrument] === loadPromise) {
        delete sampleLoadPromises[instrument];
      }
      updateInstrumentSampleState(instrument, sampleLoadStates[instrument]);
      updateAudioReadinessUi();
    });

    return loadPromise;
  }

  async function loadSamples(instruments, options) {
    if (!audioCtx) {
      updateAudioReadinessUi();
      return;
    }

    await Promise.allSettled(
      instruments.map(function (instrument) {
        return loadSample(instrument, options);
      })
    );
    updateAudioReadinessUi();
  }

  async function retryFailedSamples() {
    const failedInstruments = getSampleLoadSummary().failed;
    if (!failedInstruments.length) return;
    const shouldMoveFocusToStatus = document.activeElement === retrySamplesBtn;
    if (shouldMoveFocusToStatus && audioStatus) {
      audioStatus.focus();
    }
    isRetryingSamples = true;
    playbackAudioError = null;
    updateAudioReadinessUi();

    try {
      await loadSamples(failedInstruments, { reload: true });
    } finally {
      isRetryingSamples = false;
      updateAudioReadinessUi();
      if (shouldMoveFocusToStatus && retrySamplesBtn) {
        if (retrySamplesBtn.hidden && audioStatus) {
          audioStatus.focus();
        } else {
          retrySamplesBtn.focus();
        }
      }
    }
  }

  /************************************************
   * Base64 helpers
   ************************************************/
  function patternToBytes(patternStr) {
    const dec = parseInt(patternStr, 2);
    const hi = (dec >> 8) & 0xff;
    const lo = dec & 0xff;
    return [hi, lo];
  }

  function bytesToPattern(hi, lo) {
    const dec = (hi << 8) | lo;
    let bin = dec.toString(2);
    return bin.padStart(STEPS_PER_PATTERN, "0");
  }

  function arrayBufferToBase64(ab) {
    let str = "";
    const bytes = ab instanceof Uint8Array ? ab : new Uint8Array(ab);
    for (let i = 0; i < bytes.length; i++) {
      str += String.fromCharCode(bytes[i]);
    }
    return btoa(str);
  }

  function base64ToArrayBuffer(b64) {
    const bin = atob(b64);
    const len = bin.length;
    const bytes = new Uint8Array(len);
    for (let i = 0; i < len; i++) {
      bytes[i] = bin.charCodeAt(i);
    }
    return bytes.buffer;
  }

  function normalizePatternBytes(value) {
    const normalized = createEmptyPatternBytes();
    if (!value) return normalized;

    const source = value instanceof Uint8Array ? value : new Uint8Array(value);
    const copyLength = Math.min(source.length, BYTES_PER_PATTERN);
    for (let i = 0; i < copyLength; i++) {
      normalized[i] = source[i];
    }
    return normalized;
  }

  function ensureSongState() {
    patterns = Array.isArray(patterns)
      ? patterns.map(function (patternBytes) {
          return normalizePatternBytes(patternBytes);
        })
      : [];

    if (!patterns.length) {
      patterns = [createEmptyPatternBytes()];
    }

    patternRepeats = Array.isArray(patternRepeats)
      ? patternRepeats.map(function (repeatCount) {
          return clampInt(repeatCount, 1, MAX_PATTERN_REPEATS, 1);
        })
      : [];

    if (patternRepeats.length < patterns.length) {
      while (patternRepeats.length < patterns.length) {
        patternRepeats.push(1);
      }
    } else if (patternRepeats.length > patterns.length) {
      patternRepeats = patternRepeats.slice(0, patterns.length);
    }

    patternPitchOffsets = Array.isArray(patternPitchOffsets)
      ? patternPitchOffsets.map(function (patternPitch) {
          return normalizePatternPitchOffsets(patternPitch);
        })
      : [];

    if (patternPitchOffsets.length < patterns.length) {
      while (patternPitchOffsets.length < patterns.length) {
        patternPitchOffsets.push(createDefaultPatternPitchOffsets());
      }
    } else if (patternPitchOffsets.length > patterns.length) {
      patternPitchOffsets = patternPitchOffsets.slice(0, patterns.length);
    }

    selectedPatternIndex = clampInt(
      selectedPatternIndex,
      0,
      patterns.length - 1,
      0
    );

    playbackPatternIndex = clampInt(
      playbackPatternIndex,
      0,
      patterns.length - 1,
      0
    );
    stepsInPlaybackPattern = Math.max(0, stepsInPlaybackPattern);
  }

  function getInstrumentContainer(instrument) {
    return document.querySelector(".steps[data-instrument='" + instrument + "']");
  }

  function readPatternFromGrid() {
    const data = new Uint8Array(BYTES_PER_PATTERN);
    let offset = 0;

    for (let instr of instrumentsOrder) {
      const container = getInstrumentContainer(instr);
      let patternStr = "";

      for (let i = 0; i < STEPS_PER_PATTERN; i++) {
        if (!container) {
          patternStr += "0";
          continue;
        }
        const stepDiv = container.querySelector("[data-step='" + i + "']");
        patternStr += stepDiv && stepDiv.classList.contains("active") ? "1" : "0";
      }

      const bytes = patternToBytes(patternStr);
      data[offset++] = bytes[0];
      data[offset++] = bytes[1];
    }

    return data;
  }

  function writePatternToGrid(patternBytes) {
    const normalizedPattern = normalizePatternBytes(patternBytes);
    let offset = 0;

    for (let instr of instrumentsOrder) {
      const container = getInstrumentContainer(instr);
      const hi = normalizedPattern[offset++];
      const lo = normalizedPattern[offset++];
      const patternStr = bytesToPattern(hi, lo);

      if (!container) continue;

      for (let i = 0; i < STEPS_PER_PATTERN; i++) {
        const stepDiv = container.querySelector("[data-step='" + i + "']");
        if (!stepDiv) continue;
        setStepActiveState(stepDiv, patternStr[i] === "1");
      }
    }
  }

  function saveSelectedPatternFromGrid() {
    ensureSongState();
    patterns[selectedPatternIndex] = readPatternFromGrid();
  }

  function loadSelectedPatternIntoGrid() {
    ensureSongState();
    writePatternToGrid(patterns[selectedPatternIndex]);
    renderPitchRollGrid();
    updatePatternMeta();
  }

  function selectPatternForEditing(nextIndex) {
    saveSelectedPatternFromGrid();
    selectedPatternIndex = clampInt(nextIndex, 0, patterns.length - 1, 0);
    if (isPlaying && loopPatternMode) {
      playbackPatternIndex = selectedPatternIndex;
      stepsInPlaybackPattern = 0;
      current16th = 0;
      nextNoteTime = audioCtx.currentTime;
    }
    loadSelectedPatternIntoGrid();
    renderPatternList();
  }

  function syncEditingPatternToPlayback() {
    ensureSongState();
    if (!patterns.length) return;

    saveSelectedPatternFromGrid();
    selectedPatternIndex = clampInt(playbackPatternIndex, 0, patterns.length - 1, 0);
    writePatternToGrid(patterns[selectedPatternIndex]);
    renderPitchRollGrid();
    renderPatternList();
    updatePatternMeta();
  }

  function getRepeatsForPattern(patternIndex) {
    return clampInt(patternRepeats[patternIndex], 1, MAX_PATTERN_REPEATS, 1);
  }

  function updateLoopPatternButtonState() {
    loopPatternBtn.classList.toggle("is-active", loopPatternMode);
    loopPatternBtn.setAttribute("aria-pressed", loopPatternMode ? "true" : "false");
    loopPatternBtnLabel.textContent = loopPatternMode ? "Loop On" : "Loop Pattern";
  }

  function setLoopPatternMode(enabled) {
    loopPatternMode = Boolean(enabled);
    updateLoopPatternButtonState();

    if (!loopPatternMode) {
      return;
    }

    ensureSongState();
    playbackPatternIndex = clampInt(selectedPatternIndex, 0, patterns.length - 1, 0);
    stepsInPlaybackPattern = 0;
    current16th = 0;
    if (isPlaying) {
      nextNoteTime = audioCtx.currentTime;
    }
  }

  function clearPatternDropIndicators() {
    pendingDropInsertIndex = null;
    if (patternDropIndicator && patternDropIndicator.parentElement) {
      patternDropIndicator.parentElement.removeChild(patternDropIndicator);
    }
  }

  function getPatternListDragAxis() {
    if (!patternList || !patternList.isConnected) return "y";
    const styles = window.getComputedStyle(patternList);
    return styles.display === "flex" && styles.flexDirection.startsWith("row")
      ? "x"
      : "y";
  }

  function showPatternDropIndicator(insertIndex) {
    if (!patternList || !patternList.isConnected) return;

    const rows = Array.from(patternList.querySelectorAll(".arrange-row"));
    const nextInsertIndex = clampInt(insertIndex, 0, rows.length, rows.length);
    pendingDropInsertIndex = nextInsertIndex;

    if (!patternDropIndicator) {
      patternDropIndicator = document.createElement("div");
      patternDropIndicator.className = "pattern-drop-indicator";
      patternDropIndicator.style.background = "var(--pattern-orange, #f05a28)";
      patternDropIndicator.style.pointerEvents = "none";
    }

    if (getPatternListDragAxis() === "x") {
      patternDropIndicator.style.width = "3px";
      patternDropIndicator.style.height = "44px";
      patternDropIndicator.style.flex = "0 0 3px";
    } else {
      patternDropIndicator.style.width = "100%";
      patternDropIndicator.style.height = "3px";
      patternDropIndicator.style.flex = "0 0 3px";
    }

    const refNode = nextInsertIndex >= rows.length ? null : rows[nextInsertIndex];
    patternList.insertBefore(patternDropIndicator, refNode);
  }

  function getDropInsertIndexFromPointer(clientX, clientY) {
    if (!patternList || !patternList.isConnected) return 0;

    const rows = Array.from(patternList.querySelectorAll(".arrange-row"));
    if (!rows.length) return 0;

    const axis = getPatternListDragAxis();

    for (let i = 0; i < rows.length; i++) {
      const rect = rows[i].getBoundingClientRect();
      const pointer = axis === "x" ? clientX : clientY;
      const midpoint =
        axis === "x"
          ? rect.left + rect.width / 2
          : rect.top + rect.height / 2;
      if (pointer < midpoint) {
        return i;
      }
    }

    return rows.length;
  }

  function movePattern(fromIndex, insertIndex) {
    ensureSongState();
    if (patterns.length < 2) return;

    const from = clampInt(fromIndex, 0, patterns.length - 1, 0);
    let to = clampInt(insertIndex, 0, patterns.length, from);
    if (to > from) {
      to -= 1;
    }
    if (from === to) return;

    saveSelectedPatternFromGrid();
    const selectedPatternRef = patterns[selectedPatternIndex];
    const playbackPatternRef = patterns[playbackPatternIndex];

    const movedPattern = patterns.splice(from, 1)[0];
    const movedRepeat = patternRepeats.splice(from, 1)[0];
    const movedPitchOffsets = patternPitchOffsets.splice(from, 1)[0];
    patterns.splice(to, 0, movedPattern);
    patternRepeats.splice(to, 0, movedRepeat);
    patternPitchOffsets.splice(to, 0, normalizePatternPitchOffsets(movedPitchOffsets));

    selectedPatternIndex = Math.max(0, patterns.indexOf(selectedPatternRef));
    playbackPatternIndex = Math.max(0, patterns.indexOf(playbackPatternRef));

    ensureSongState();
    loadSelectedPatternIntoGrid();
    renderPatternList();
    updatePatternMeta();
  }

  function movePatternByOffset(fromIndex, offset) {
    const targetIndex = clampInt(
      fromIndex + offset,
      0,
      patterns.length - 1,
      fromIndex
    );
    if (targetIndex === fromIndex) return;

    const insertIndex = targetIndex > fromIndex ? targetIndex + 1 : targetIndex;
    movePattern(fromIndex, insertIndex);

    const movedRow = patternList
      ? patternList.querySelectorAll(".arrange-row")[targetIndex]
      : null;
    if (!movedRow) return;

    const preferredSelector = offset < 0 ? ".is-move-up" : ".is-move-down";
    const fallbackSelector = offset < 0 ? ".is-move-down" : ".is-move-up";
    const preferredControl = movedRow.querySelector(preferredSelector);
    const fallbackControl = movedRow.querySelector(fallbackSelector);
    let focusTarget = preferredControl;
    if (!focusTarget || focusTarget.disabled) {
      focusTarget = fallbackControl;
    }
    if (!focusTarget || focusTarget.disabled) {
      focusTarget = movedRow.querySelector(".arrange-pattern-button");
    }
    if (focusTarget) {
      focusTarget.focus();
    }
  }

  function duplicatePatternAtIndex(sourceIndex) {
    ensureSongState();
    const source = clampInt(sourceIndex, 0, patterns.length - 1, selectedPatternIndex);

    saveSelectedPatternFromGrid();
    const playbackPatternRef = patterns[playbackPatternIndex];
    const sourcePattern = patterns[source];
    const sourceRepeats = getRepeatsForPattern(source);
    const insertIndex = source + 1;

    patterns.splice(insertIndex, 0, normalizePatternBytes(sourcePattern));
    patternRepeats.splice(insertIndex, 0, sourceRepeats);
    patternPitchOffsets.splice(
      insertIndex,
      0,
      normalizePatternPitchOffsets(patternPitchOffsets[source])
    );
    selectedPatternIndex = insertIndex;

    if (playbackPatternRef) {
      const nextPlaybackIndex = patterns.indexOf(playbackPatternRef);
      playbackPatternIndex = nextPlaybackIndex === -1 ? 0 : nextPlaybackIndex;
    }

    ensureSongState();
    if (isPlaying && loopPatternMode) {
      playbackPatternIndex = selectedPatternIndex;
      stepsInPlaybackPattern = 0;
      current16th = 0;
      nextNoteTime = audioCtx.currentTime;
    }
    loadSelectedPatternIntoGrid();
    renderPatternList();
    updatePatternMeta();
  }

  function deletePatternAtIndex(targetIndex) {
    ensureSongState();
    if (patterns.length <= 1) {
      alert("You need at least one pattern.");
      return;
    }

    const target = clampInt(targetIndex, 0, patterns.length - 1, selectedPatternIndex);
    saveSelectedPatternFromGrid();
    const playbackPatternRef = patterns[playbackPatternIndex];

    patterns.splice(target, 1);
    patternRepeats.splice(target, 1);
    patternPitchOffsets.splice(target, 1);

    if (selectedPatternIndex > target) {
      selectedPatternIndex -= 1;
    } else if (selectedPatternIndex === target) {
      selectedPatternIndex = Math.min(target, patterns.length - 1);
    }

    if (playbackPatternRef) {
      const nextPlaybackIndex = patterns.indexOf(playbackPatternRef);
      playbackPatternIndex =
        nextPlaybackIndex === -1
          ? Math.min(target, patterns.length - 1)
          : nextPlaybackIndex;
    }

    ensureSongState();
    if (isPlaying && loopPatternMode) {
      playbackPatternIndex = selectedPatternIndex;
      stepsInPlaybackPattern = 0;
      current16th = 0;
      nextNoteTime = audioCtx.currentTime;
    }
    loadSelectedPatternIntoGrid();
    renderPatternList();
    updatePatternMeta();
  }

  function updatePatternMeta() {
    ensureSongState();
    const patternSummary = document.querySelector(".pattern-manager-summary");
    if (patternSummary) {
      patternSummary.textContent =
        "Pattern " + (selectedPatternIndex + 1) + " · " + patterns.length + " total";
    }
  }

  function renderPatternList() {
    ensureSongState();
    if (!patternList || !patternList.isConnected) {
      if (!bindArrangementElements()) {
        return;
      }
    }
    patternList.innerHTML = "";

    patterns.forEach(function (_, index) {
      const row = document.createElement("div");
      row.className = "arrange-row group flex items-center gap-2 rounded-sm px-1";
      row.draggable = true;

      row.addEventListener("dragstart", function (event) {
        draggedPatternIndex = index;
        row.classList.add("opacity-60");
        clearPatternDropIndicators();
        if (event.dataTransfer) {
          event.dataTransfer.effectAllowed = "move";
          event.dataTransfer.setData("text/plain", index.toString());
        }
      });

      row.addEventListener("dragend", function () {
        row.classList.remove("opacity-60");
        clearPatternDropIndicators();
        draggedPatternIndex = null;
      });

      const dragHandle = document.createElement("span");
      dragHandle.className =
        "arrange-drag-handle w-5 cursor-grab select-none text-center text-xs transition";
      dragHandle.textContent = ":::";
      dragHandle.setAttribute("aria-hidden", "true");
      row.appendChild(dragHandle);

      const patternCard = document.createElement("div");
      patternCard.className =
        "arrange-pattern-card flex flex-1 items-center gap-1 rounded-sm border px-2 py-1 transition";
      if (index === selectedPatternIndex) {
        patternCard.className += " is-selected";
      } else {
        patternCard.className += " is-idle";
      }

      const patternBtn = document.createElement("button");
      patternBtn.type = "button";
      patternBtn.className =
        "arrange-pattern-button min-w-0 flex-1 truncate rounded-sm px-1 py-1 text-left text-sm font-semibold tracking-wide transition focus:outline-none";
      patternBtn.textContent = "Pattern " + (index + 1);
      patternBtn.addEventListener("click", function () {
        selectPatternForEditing(index);
      });
      patternCard.appendChild(patternBtn);

      const rowActions = document.createElement("div");
      rowActions.className = "arrange-row-actions flex items-center gap-0.5";

      const moveUpBtn = document.createElement("button");
      moveUpBtn.type = "button";
      moveUpBtn.className =
        "arrange-row-action is-move-up inline-flex items-center justify-center rounded-sm transition focus:outline-none";
      moveUpBtn.textContent = "↑";
      moveUpBtn.setAttribute("aria-label", "Move pattern " + (index + 1) + " up");
      moveUpBtn.setAttribute("draggable", "false");
      moveUpBtn.disabled = index === 0;
      moveUpBtn.addEventListener("mousedown", function (event) {
        event.stopPropagation();
      });
      moveUpBtn.addEventListener("dragstart", function (event) {
        event.preventDefault();
      });
      moveUpBtn.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        movePatternByOffset(index, -1);
      });
      rowActions.appendChild(moveUpBtn);

      const moveDownBtn = document.createElement("button");
      moveDownBtn.type = "button";
      moveDownBtn.className =
        "arrange-row-action is-move-down inline-flex items-center justify-center rounded-sm transition focus:outline-none";
      moveDownBtn.textContent = "↓";
      moveDownBtn.setAttribute(
        "aria-label",
        "Move pattern " + (index + 1) + " down"
      );
      moveDownBtn.setAttribute("draggable", "false");
      moveDownBtn.disabled = index === patterns.length - 1;
      moveDownBtn.addEventListener("mousedown", function (event) {
        event.stopPropagation();
      });
      moveDownBtn.addEventListener("dragstart", function (event) {
        event.preventDefault();
      });
      moveDownBtn.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        movePatternByOffset(index, 1);
      });
      rowActions.appendChild(moveDownBtn);

      const duplicateRowBtn = document.createElement("button");
      duplicateRowBtn.type = "button";
      duplicateRowBtn.className =
        "arrange-row-action is-duplicate inline-flex items-center justify-center rounded-sm transition focus:outline-none";
      duplicateRowBtn.innerHTML = DUPLICATE_PATTERN_ICON;
      duplicateRowBtn.setAttribute("aria-label", "Duplicate pattern " + (index + 1));
      duplicateRowBtn.setAttribute("draggable", "false");
      duplicateRowBtn.addEventListener("mousedown", function (event) {
        event.stopPropagation();
      });
      duplicateRowBtn.addEventListener("dragstart", function (event) {
        event.preventDefault();
      });
      duplicateRowBtn.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        duplicatePatternAtIndex(index);
      });
      rowActions.appendChild(duplicateRowBtn);

      const deleteRowBtn = document.createElement("button");
      deleteRowBtn.type = "button";
      deleteRowBtn.className =
        "arrange-row-action is-delete inline-flex items-center justify-center rounded-sm transition focus:outline-none";
      deleteRowBtn.innerHTML = DELETE_PATTERN_ICON;
      deleteRowBtn.setAttribute("aria-label", "Delete pattern " + (index + 1));
      deleteRowBtn.setAttribute("draggable", "false");
      deleteRowBtn.disabled = patterns.length <= 1;
      deleteRowBtn.addEventListener("mousedown", function (event) {
        event.stopPropagation();
      });
      deleteRowBtn.addEventListener("dragstart", function (event) {
        event.preventDefault();
      });
      deleteRowBtn.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        const confirmed = window.confirm(
          "Delete pattern " + (index + 1) + "? This cannot be undone."
        );
        if (!confirmed) return;
        deletePatternAtIndex(index);
      });
      rowActions.appendChild(deleteRowBtn);

      patternCard.appendChild(rowActions);
      row.appendChild(patternCard);

      const repeatInput = document.createElement("input");
      repeatInput.type = "number";
      repeatInput.min = "1";
      repeatInput.max = MAX_PATTERN_REPEATS.toString();
      repeatInput.value = getRepeatsForPattern(index).toString();
      repeatInput.className =
        "arrange-repeat-input w-20 rounded-sm border px-2 py-2 text-sm focus:outline-none";
      repeatInput.setAttribute(
        "aria-label",
        "How many times pattern " + (index + 1) + " should play"
      );
      repeatInput.addEventListener("change", function () {
        const repeats = clampInt(
          repeatInput.value,
          1,
          MAX_PATTERN_REPEATS,
          1
        );
        patternRepeats[index] = repeats;
        repeatInput.value = repeats.toString();
        updatePatternMeta();
      });
      row.appendChild(repeatInput);

      const timesLabel = document.createElement("span");
      timesLabel.className = "arrange-times-label w-12 text-xs";
      timesLabel.textContent = "times";
      row.appendChild(timesLabel);

      patternList.appendChild(row);
    });
  }

  function wireArrangementControls() {
    if (arrangementControlsBound) {
      if (areArrangementElementsConnected()) {
        return true;
      }
      arrangementControlsBound = false;
    }

    if (!bindArrangementElements()) {
      return false;
    }

    arrangementControlsBound = true;

    patternList.addEventListener("dragover", function (event) {
      event.preventDefault();
      if (draggedPatternIndex === null) {
        clearPatternDropIndicators();
        return;
      }

      const insertIndex = getDropInsertIndexFromPointer(
        event.clientX,
        event.clientY
      );
      showPatternDropIndicator(insertIndex);
    });

    patternList.addEventListener("drop", function (event) {
      event.preventDefault();

      const from =
        draggedPatternIndex !== null
          ? draggedPatternIndex
          : parseInt(
              event.dataTransfer ? event.dataTransfer.getData("text/plain") : "",
              10
            );
      if (isNaN(from)) {
        clearPatternDropIndicators();
        draggedPatternIndex = null;
        return;
      }

      if (pendingDropInsertIndex === null) {
        pendingDropInsertIndex = getDropInsertIndexFromPointer(
          event.clientX,
          event.clientY
        );
      }

      const insertIndex = pendingDropInsertIndex;
      movePattern(from, insertIndex);
      clearPatternDropIndicators();
      draggedPatternIndex = null;
    });

    newPatternBtn.addEventListener("click", function () {
      saveSelectedPatternFromGrid();
      patterns.push(createEmptyPatternBytes());
      patternRepeats.push(1);
      patternPitchOffsets.push(createDefaultPatternPitchOffsets());
      selectedPatternIndex = patterns.length - 1;
      loadSelectedPatternIntoGrid();
      renderPatternList();
      updatePatternMeta();
    });

    clearPatternBtn.addEventListener("click", function () {
      ensureSongState();
      patterns[selectedPatternIndex] = createEmptyPatternBytes();
      patternPitchOffsets[selectedPatternIndex] = createDefaultPatternPitchOffsets();
      loadSelectedPatternIntoGrid();
      renderPatternList();
      updatePatternMeta();
    });

    return true;
  }

  /************************************************
   * PLAY / STOP
   ************************************************/
  playBtn.addEventListener("click", async function () {
    if (!isPlaying) {
      await startSequencer();
    } else {
      stopSequencer();
    }
  });

  async function startSequencer() {
    if (isPlaying || isStartingPlayback) return;

    const sampleSummary = getSampleLoadSummary();
    if (!audioCtx || !masterGainNode || sampleSummary.ready.length === 0) {
      updateAudioReadinessUi();
      return;
    }

    const requestId = ++playbackStartRequestId;
    isStartingPlayback = true;
    playbackAudioError = null;
    getValidatedBpm(bpmInput.value);
    renderInstrumentScreen();
    updateAudioReadinessUi();

    try {
      if (audioCtx.state !== "running") {
        await audioCtx.resume();
      }

      if (
        requestId !== playbackStartRequestId ||
        document.visibilityState === "hidden"
      ) {
        return;
      }

      if (audioCtx.state !== "running") {
        throw new Error("Audio could not start. Check browser audio permissions and retry.");
      }

      saveSelectedPatternFromGrid();
      ensureSongState();

      if (masterEffectsChain) {
        const graph = masterEffectsChain;
        let filterReady = false;
        const trackedClose = filterTransportClosePromise;
        const closeCompleted = await trackedClose;

        if (requestId !== playbackStartRequestId) {
          return;
        }

        purgeRetiringSources();
        if (!closeCompleted && graph === masterEffectsChain) {
          throw new Error("The terminal effects gate could not close safely.");
        }

        try {
          if (graph === masterEffectsChain) {
            filterReady = await graph.wake();
            refreshEffectsAvailability();
          }
        } catch (filterError) {
          if (graph === masterEffectsChain) {
            audioInitializationError = filterError;
          }
        }

        if (requestId !== playbackStartRequestId) {
          return;
        }

        if (
          document.visibilityState === "hidden" ||
          audioCtx.state !== "running"
        ) {
          if (graph === masterEffectsChain) {
            trackFilterTransportClose(
              graph,
              graph.silence({ immediate: true })
            );
          }
          return;
        }

        if (!filterReady && graph === masterEffectsChain) {
          throw new Error("The effects transport gate could not reopen safely.");
        }
      } else {
        purgeRetiringSources();
      }

      if (!masterGainNode) {
        throw new Error("Audio output is unavailable. Reload the page and retry.");
      }

      isPlaying = true;
      playBtnLabel.textContent = "Stop";
      playBtnIconPlay.classList.add("btn-icon-hidden");
      playBtnIconStop.classList.remove("btn-icon-hidden");
      current16th = 0;
      renderInstrumentScreen(current16th);
      playbackPatternIndex = loopPatternMode
        ? clampInt(selectedPatternIndex, 0, patterns.length - 1, 0)
        : 0;
      stepsInPlaybackPattern = 0;
      nextNoteTime = audioCtx.currentTime;
      if (loopPatternMode) {
        loadSelectedPatternIntoGrid();
        renderPatternList();
        updatePatternMeta();
      } else {
        syncEditingPatternToPlayback();
      }
      schedulerLoop();
    } catch (error) {
      if (requestId === playbackStartRequestId) {
        playbackAudioError =
          error instanceof Error
            ? error.message
            : "Audio could not start. Please retry playback.";
        stopSequencer();
      }
    } finally {
      if (requestId === playbackStartRequestId) {
        isStartingPlayback = false;
        renderInstrumentScreen();
        updateAudioReadinessUi();
      }
    }
  }

  function stopSequencer() {
    playbackStartRequestId += 1;
    isStartingPlayback = false;
    isPlaying = false;
    playBtnLabel.textContent = "Play";
    playBtnIconPlay.classList.remove("btn-icon-hidden");
    playBtnIconStop.classList.add("btn-icon-hidden");
    renderInstrumentScreen();
    if (schedulerIntervalId) {
      clearInterval(schedulerIntervalId);
      schedulerIntervalId = null;
    }
    let closeOperation = Promise.resolve(true);
    if (masterEffectsChain) {
      const graph = masterEffectsChain;
      try {
        closeOperation = trackFilterTransportClose(
          graph,
          graph.silence({
            immediate: !audioCtx || audioCtx.state !== "running",
          })
        );
      } catch (error) {
        audioInitializationError = error;
        closeOperation = Promise.resolve(false);
      }
    }
    cancelScheduledSources();
    clearScheduledHighlightTimers();
    clearPlayingHighlight();
    updatePatternMeta();
    updateAudioReadinessUi();
    return closeOperation;
  }

  function resetProjectState() {
    if (isPlaying || isStartingPlayback) {
      stopSequencer();
    }

    setLoopPatternMode(false);
    clearPatternDropIndicators();
    clearPlayingHighlight();
    closePitchRoll();

    patterns = [createEmptyPatternBytes()];
    patternRepeats = [1];
    patternPitchOffsets = [createDefaultPatternPitchOffsets()];
    setAllInstrumentVolumes(createDefaultInstrumentVolumes());
    selectedPatternIndex = 0;
    playbackPatternIndex = 0;
    stepsInPlaybackPattern = 0;
    current16th = 0;

    playbackAudioError = null;
    bpmInput.value = DEFAULT_BPM.toString();
    resetFilterEffectState();
    spaceController.replaceWithDefault({ immediate: true });
    renderInstrumentScreen(0);
    ensureSongState();
    loadSelectedPatternIntoGrid();
    renderPatternList();
    updatePatternMeta();

    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, "", window.location.pathname);
    }
    updateAudioReadinessUi();
  }

  /************************************************
   * setInterval-based scheduler
   ************************************************/
  function schedulerLoop() {
    if (schedulerIntervalId) return;

    schedulerIntervalId = setInterval(function () {
      let scheduledStepCount = 0;
      const lookaheadLimit = audioCtx.currentTime + 0.1;

      if (!Number.isFinite(nextNoteTime)) {
        playbackAudioError = "Playback stopped because its timing became invalid.";
        stopSequencer();
        return;
      }

      if (audioCtx.currentTime - nextNoteTime > MAX_SCHEDULER_LAG_SECONDS) {
        playbackAudioError =
          "Playback stopped after falling too far behind to recover safely.";
        stopSequencer();
        return;
      }

      while (nextNoteTime < lookaheadLimit && scheduledStepCount < MAX_SCHEDULER_STEPS_PER_TICK) {
        if (!Number.isFinite(nextNoteTime)) {
          playbackAudioError = "Playback stopped because its timing became invalid.";
          stopSequencer();
          return;
        }

        const previousNoteTime = nextNoteTime;
        scheduleStep(current16th, nextNoteTime);
        nextNote();
        scheduledStepCount += 1;

        if (!(nextNoteTime > previousNoteTime)) {
          playbackAudioError = "Playback stopped because the tempo could not advance safely.";
          stopSequencer();
          return;
        }
      }

      if (nextNoteTime < lookaheadLimit) {
        playbackAudioError =
          "Playback stopped after falling too far behind to recover safely.";
        stopSequencer();
      }
    }, scheduleInterval);
  }

  /************************************************
   * nextNote & scheduleStep
   ************************************************/
  function nextNote() {
    nextNoteTime += getSixteenthNoteDurationSeconds(bpmInput.value);
    current16th = (current16th + 1) % STEPS_PER_PATTERN;
    stepsInPlaybackPattern += 1;

    const patternLength = loopPatternMode
      ? STEPS_PER_PATTERN
      : getRepeatsForPattern(playbackPatternIndex) * STEPS_PER_PATTERN;

    if (stepsInPlaybackPattern >= patternLength) {
      stepsInPlaybackPattern = 0;
      if (loopPatternMode) {
        playbackPatternIndex = clampInt(
          selectedPatternIndex,
          0,
          patterns.length - 1,
          0
        );
        updatePatternMeta();
      } else {
        playbackPatternIndex = (playbackPatternIndex + 1) % patterns.length;
        syncEditingPatternToPlayback();
      }
    }
  }

  function isStepActive(patternBytes, instrumentIndex, stepIndex) {
    const offset = instrumentIndex * 2;
    const hi = patternBytes[offset];
    const lo = patternBytes[offset + 1];
    const patternVal = (hi << 8) | lo;
    const mask = 1 << (STEPS_PER_PATTERN - stepIndex - 1);
    return (patternVal & mask) !== 0;
  }

  function scheduleStep(stepIndex, time) {
    const patternBytes = patterns[playbackPatternIndex];

    instrumentsOrder.forEach(function (instrument, instrumentIndex) {
      if (isStepActive(patternBytes, instrumentIndex, stepIndex)) {
        const pitchOffset = getStepPitchOffset(
          playbackPatternIndex,
          instrument,
          stepIndex
        );
        playSound(instrument, time, pitchOffset);
      }
    });

    const delay = (time - audioCtx.currentTime) * 1000;
    const timeoutId = window.setTimeout(function () {
      scheduledHighlightTimers.delete(timeoutId);
      if (isPlaying) {
        highlightStep(stepIndex);
      }
    }, Math.max(0, delay));
    scheduledHighlightTimers.add(timeoutId);
  }

  function disconnectScheduledSource(source, gainNode) {
    try {
      source.disconnect();
    } catch (_error) {
      // The source may already be disconnected by the browser.
    }
    try {
      gainNode.disconnect();
    } catch (_error) {
      // The gain may already be disconnected by the browser.
    }
  }

  function releaseScheduledSource(source) {
    const scheduledSource =
      scheduledSources.get(source) || retiringSources.get(source);
    if (!scheduledSource) return;
    scheduledSources.delete(source);
    retiringSources.delete(source);
    disconnectScheduledSource(source, scheduledSource.gainNode);
  }

  function stopAndDisconnectScheduledSource(source, scheduledSource) {
    scheduledSources.delete(source);
    retiringSources.delete(source);
    try {
      source.stop();
    } catch (_error) {
      // A naturally ended or previously stopped source still needs disconnection.
    }
    disconnectScheduledSource(source, scheduledSource.gainNode);
  }

  function purgeRetiringSources() {
    Array.from(retiringSources.entries()).forEach(function ([source, scheduledSource]) {
      stopAndDisconnectScheduledSource(source, scheduledSource);
    });
  }

  function cancelScheduledSources(options) {
    const forceImmediate = Boolean(options && options.forceImmediate);
    if (!audioCtx) {
      const allSources = new Map([...scheduledSources, ...retiringSources]);
      allSources.forEach(function (scheduledSource, source) {
        stopAndDisconnectScheduledSource(source, scheduledSource);
      });
      scheduledSources.clear();
      retiringSources.clear();
      return;
    }

    const now = audioCtx.currentTime;
    const contextIsRunning = audioCtx.state === "running" && !forceImmediate;
    Array.from(scheduledSources.entries()).forEach(function ([source, scheduledSource]) {
      scheduledSources.delete(source);
      if (!contextIsRunning || scheduledSource.startTime > now) {
        stopAndDisconnectScheduledSource(source, scheduledSource);
        return;
      }

      retiringSources.set(source, scheduledSource);
      try {
          const fadeEndTime = now + 0.012;
          scheduledSource.gainNode.gain.cancelScheduledValues(now);
          scheduledSource.gainNode.gain.setValueAtTime(
            scheduledSource.gainNode.gain.value,
            now
          );
          scheduledSource.gainNode.gain.linearRampToValueAtTime(0, fadeEndTime);
          source.stop(fadeEndTime + 0.003);
      } catch (_error) {
        stopAndDisconnectScheduledSource(source, scheduledSource);
      }
    });

    if (!contextIsRunning) {
      purgeRetiringSources();
    }
  }

  function clearScheduledHighlightTimers() {
    scheduledHighlightTimers.forEach(function (timeoutId) {
      window.clearTimeout(timeoutId);
    });
    scheduledHighlightTimers.clear();
  }

  function playSound(instrument, when, pitchOffset) {
    const buf = audioBuffers[instrument];
    if (!buf || !audioCtx || !masterGainNode) return;
    const source = audioCtx.createBufferSource();
    const gainNode = audioCtx.createGain();
    source.buffer = buf;
    source.playbackRate.value = Math.pow(2, clampPitchOffset(pitchOffset) / 12);
    gainNode.gain.value = getInstrumentVolumeGain(instrument);
    source.connect(gainNode);
    gainNode.connect(masterGainNode);
    scheduledSources.set(source, {
      gainNode: gainNode,
      startTime: when,
    });
    source.onended = function () {
      releaseScheduledSource(source);
    };

    try {
      source.start(when);
    } catch (error) {
      releaseScheduledSource(source);
      console.error("Could not schedule " + instrument + " sample:", error);
    }
  }

  /************************************************
   * Highlight Functions
   ************************************************/
  function highlightStep(stepIndex) {
    clearPlayingHighlight();
    renderInstrumentScreen(stepIndex);
    document
      .querySelectorAll("[data-step='" + stepIndex + "']")
      .forEach(function (el) {
        el.classList.add("playing");
      });
  }

  function clearPlayingHighlight() {
    document.querySelectorAll(".step.playing").forEach(function (el) {
      el.classList.remove("playing");
    });
  }

  function encodeSongState() {
    const serializedPitch = patternPitchOffsets
      .slice(0, patterns.length)
      .map(function (patternPitch) {
        return serializePatternPitchOffsets(patternPitch);
      });
    const hasPitchData = serializedPitch.some(function (patternPitch) {
      return Object.keys(patternPitch).length > 0;
    });

    const payload = {
      v: 4,
      p: patterns.map(function (patternBytes) {
        return arrayBufferToBase64(patternBytes);
      }),
      r: patternRepeats.slice(0, patterns.length),
      m: instrumentsOrder.map(function (instrument) {
        return getInstrumentVolumePercent(instrument);
      }),
    };
    if (hasPitchData) {
      payload.t = serializedPitch;
    }
    const serializedFilter = serializeFilterEffectState(filterEffectState);
    const serializedSpace = serializeSpaceEffectState(spaceEffectState);
    if (serializedFilter || serializedSpace) {
      payload.v = FILTER_SONG_SCHEMA_VERSION;
    }
    if (serializedFilter) {
      payload.f = serializedFilter;
    }
    if (serializedSpace) {
      payload.s = serializedSpace;
    }
    return btoa(JSON.stringify(payload));
  }

  function loadSongStateFromBase64(songB64) {
    try {
      const decoded = atob(songB64);
      const payload = JSON.parse(decoded);
      if (!payload || !Array.isArray(payload.p)) {
        return false;
      }

      const loadedPatterns = payload.p
        .map(function (patternB64) {
          if (typeof patternB64 !== "string") return null;
          try {
            const bytes = new Uint8Array(base64ToArrayBuffer(patternB64));
            if (bytes.length < 2 || bytes.length % 2 !== 0) {
              return null;
            }
            return normalizePatternBytes(bytes);
          } catch (err) {
            return null;
          }
        })
        .filter(function (patternBytes) {
          return Boolean(patternBytes);
        });

      if (!loadedPatterns.length) {
        return false;
      }

      const loadedFilterEffectState =
        payload.v === FILTER_SONG_SCHEMA_VERSION
          ? deserializeFilterEffectState(payload.f)
          : createDefaultFilterEffectState();
      const loadedSpaceEffectState =
        payload.v === FILTER_SONG_SCHEMA_VERSION
          ? deserializeSpaceEffectState(payload.s)
          : createDefaultSpaceEffectState();

      let loadedRepeats = [];
      let nextPatterns = loadedPatterns;
      let loadedPitchOffsets = loadedPatterns.map(function (_, patternIndex) {
        return deserializePatternPitchOffsets(
          Array.isArray(payload.t) ? payload.t[patternIndex] : null
        );
      });
      let nextPitchOffsets = loadedPitchOffsets;

      if (Array.isArray(payload.r)) {
        loadedRepeats = payload.r.map(function (repeatCount) {
          return clampInt(repeatCount, 1, MAX_PATTERN_REPEATS, 1);
        });
      } else if (Array.isArray(payload.a)) {
        const expandedPatterns = [];
        const expandedRepeats = [];
        const expandedPitchOffsets = [];

        payload.a.forEach(function (segmentArr) {
          if (!Array.isArray(segmentArr) || segmentArr.length < 2) {
            return;
          }

          const patternIndex = parseInt(segmentArr[0], 10);
          if (
            isNaN(patternIndex) ||
            patternIndex < 0 ||
            patternIndex >= loadedPatterns.length
          ) {
            return;
          }

          const repeats = clampInt(
            segmentArr[1],
            1,
            MAX_PATTERN_REPEATS,
            1
          );

          expandedPatterns.push(normalizePatternBytes(loadedPatterns[patternIndex]));
          expandedRepeats.push(repeats);
          expandedPitchOffsets.push(
            normalizePatternPitchOffsets(loadedPitchOffsets[patternIndex])
          );
        });

        if (expandedPatterns.length) {
          nextPatterns = expandedPatterns;
          loadedRepeats = expandedRepeats;
          nextPitchOffsets = expandedPitchOffsets;
        }
      }

      patterns = nextPatterns;
      patternRepeats = loadedRepeats;
      patternPitchOffsets = nextPitchOffsets;
      setAllInstrumentVolumes(payload.m);
      selectedPatternIndex = 0;
      ensureSongState();
      setFilterEffectState(loadedFilterEffectState, { immediate: true });
      spaceController.setState(loadedSpaceEffectState, { immediate: true });
      renderPitchRollGrid();
      return true;
    } catch (err) {
      console.warn("Failed to parse song state from URL:", err);
      return false;
    }
  }

  function loadSinglePatternFromBase64(patternB64) {
    try {
      const bytes = new Uint8Array(base64ToArrayBuffer(patternB64));
      if (bytes.length < 2 || bytes.length % 2 !== 0) {
        return false;
      }

      patterns = [normalizePatternBytes(bytes)];
      patternRepeats = [1];
      patternPitchOffsets = [createDefaultPatternPitchOffsets()];
      setAllInstrumentVolumes(createDefaultInstrumentVolumes());
      selectedPatternIndex = 0;
      ensureSongState();
      setFilterEffectState(createDefaultFilterEffectState(), { immediate: true });
      spaceController.replaceWithDefault({ immediate: true });
      renderPitchRollGrid();
      return true;
    } catch (err) {
      console.warn("Failed to parse single pattern from URL:", err);
      return false;
    }
  }

  /************************************************
   * SHARE BUTTON
   ************************************************/
  loopPatternBtn.addEventListener("click", function () {
    setLoopPatternMode(!loopPatternMode);
  });

  clearProjectBtn.addEventListener("click", function () {
    window.dispatchEvent(new CustomEvent("project:clear:open"));
  });

  window.addEventListener("project:clear:confirm", function () {
    resetProjectState();
  });

  shareBtn.addEventListener("click", async function () {
    try {
      if (isPlaying || isStartingPlayback) {
        stopSequencer();
      }
      saveSelectedPatternFromGrid();
      ensureSongState();

      const bpmVal = getValidatedBpm(bpmInput.value);

      const selectedPattern = patterns[selectedPatternIndex];
      const b64 = arrayBufferToBase64(selectedPattern);
      const songB64 = encodeSongState();

      const params = new URLSearchParams();
      params.set("bpm", bpmVal.toString());
      params.set("b", b64);
      params.set("song", songB64);
      params.set("mix", encodeMixParam());

      const shareUrl =
        window.location.origin + window.location.pathname + "?" + params.toString();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(shareUrl);
      } else {
        const tempInput = document.createElement("input");
        tempInput.value = shareUrl;
        document.body.appendChild(tempInput);
        tempInput.select();
        tempInput.setSelectionRange(0, 99999);
        document.execCommand("copy");
        document.body.removeChild(tempInput);
      }
      alert("Link to shared track was copied to your clipboard.");
    } catch (err) {
      console.error("Failed to copy:", err);
      alert("Failed to copy the link. Please try manually.");
    }
  });

  /************************************************
   * LOAD FROM URL PARAMS
   ************************************************/
  function loadFromURLParams() {
    const query = new URLSearchParams(window.location.search);

    bpmInput.value = normalizeBpm(query.get("bpm"), DEFAULT_BPM).toString();
    setFilterEffectState(createDefaultFilterEffectState(), { immediate: true });
    spaceController.replaceWithDefault({ immediate: true });

    let loaded = false;
    let mixLoaded = false;
    if (query.has("song")) {
      loaded = loadSongStateFromBase64(query.get("song"));
    }

    if (!loaded && query.has("b")) {
      loaded = loadSinglePatternFromBase64(query.get("b"));
    }

    if (query.has("mix")) {
      mixLoaded = loadMixParam(query.get("mix"));
    }

    if (!loaded) {
      patterns = [createEmptyPatternBytes()];
      patternRepeats = [1];
      patternPitchOffsets = [createDefaultPatternPitchOffsets()];
      if (!mixLoaded) {
        setAllInstrumentVolumes(createDefaultInstrumentVolumes());
      }
      selectedPatternIndex = 0;
      ensureSongState();
    }
  }
</script>
