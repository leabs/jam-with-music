---
import songs from "../../public/songs.json";

// Sort songs alphabetically by artist name
const sortedSongs = songs.sort((a, b) => a.artist.localeCompare(b.artist));
---
<div id="songs">
    <h2 class="header2">Song List:</h2>
    <ul class="song-list-list">
        {sortedSongs.map((song) => (
            <li>
                <a href={song.link}>{song.artist} - {song.title}</a>
            </li>
        ))}
    </ul>
</div>

<style>
    .header2 {
        margin: 8px 0 10px;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: #d4d4d8;
        font-weight: 600;
    }
    #songs a {
        color: #e4e4e7;
        text-decoration: none;
        display: inline-block;
        line-height: 1.35;
    }
    #songs a:hover {
        color: #fb923c;
    }
    .song-list-list {
        margin-top: 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.45rem;
        list-style: none;
        padding: 0;
    }
    .song-list-list li {
        margin: 0;
        border: 1px solid #3f3f46;
        background: rgba(39, 39, 42, 0.55);
        border-radius: 8px;
        padding: 8px 10px;
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }
    .song-list-list li:hover {
        border-color: #f97316;
        background: rgba(249, 115, 22, 0.12);
    }
    @media (max-width: 600px) {
        .song-list-list {
            grid-template-columns: 1fr;
        }
    }
</style>
